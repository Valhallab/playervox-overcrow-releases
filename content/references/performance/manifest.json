{
  "schemaVersion": 1,
  "id": "com.playervox.examples.performance",
  "version": "1.0.0",
  "apiVersion": "2",
  "entrypoints": {
    "view": "index.html"
  },
  "permissions": {
    "network": [],
    "gameEvents": [],
    "storage": false,
    "clipboardWrite": false,
    "capabilities": ["telemetry.read"]
  },
  "localization": {
    "defaultLocale": "en",
    "availableLocales": ["en", "fr"]
  },
  "presentation": {
    "sizing": {
      "mode": "intrinsic",
      "preferred": {
        "width": 240,
        "height": 120
      },
      "min": {
        "width": 100,
        "height": 48
      },
      "max": {
        "width": 800,
        "height": 900
      }
    },
    "options": [
      {
        "id": "details",
        "type": "boolean",
        "label": {
          "en": "Show details",
          "fr": "Afficher les détails"
        },
        "default": true
      }
    ]
  }
}
