{
  "schemaVersion": 1,
  "id": "com.playervox.examples.score",
  "version": "1.0.0",
  "apiVersion": "1",
  "entrypoints": {
    "view": "index.html"
  },
  "permissions": {
    "network": [
      {
        "origin": "https://api.playervox.com",
        "method": "GET",
        "pathPrefix": "/api/v1/overcrow/games/steam/"
      }
    ],
    "gameEvents": [],
    "storage": false,
    "clipboardWrite": false,
    "capabilities": []
  },
  "localization": {
    "defaultLocale": "en",
    "availableLocales": ["en", "fr"]
  },
  "presentation": {
    "sizing": {
      "mode": "intrinsic",
      "preferred": {
        "width": 240,
        "height": 120
      },
      "min": {
        "width": 100,
        "height": 48
      },
      "max": {
        "width": 800,
        "height": 900
      }
    },
    "options": [
      {
        "id": "details",
        "type": "boolean",
        "label": {
          "en": "Show details",
          "fr": "Afficher les détails"
        },
        "default": true
      }
    ]
  }
}
