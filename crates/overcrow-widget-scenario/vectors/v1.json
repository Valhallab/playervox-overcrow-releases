 "comment": "Widget test scenario v1 vectors (docs/widget-testing.md). `valid` scenarios parse; `derived` gives values both readers must compute: `pixels` is the image size at the scale (round to nearest of size × scale / 1000), `zone` lists [now, offsetMinutes, nextChangeAt]. `invalid` scenarios are refused with the error at `path` (\"\" for a format error). `againstManifest` cases are checked against `manifest`; `path` null means accepted.",
 "manifest": {
  "schemaVersion": 1,
  "apiVersion": 1,
  "id": "com.example.vectors",
  "version": "1.0.0",
  "name": {
   "en": "Vectors",
   "fr": "Vecteurs"
  },
  "sizing": {
   "fit": "none",
   "preferred": {
    "width": 200,
    "height": 120
   },
   "min": {
    "width": 100,
    "height": 60
   },
   "max": {
    "width": 400,
    "height": 240
   }
  },
  "permissions": {
   "network": [
    {
     "origin": "https://api.example.com",
     "method": "GET",
     "path": "/v1/items"
    }
   ],
   "storage": true,
   "capabilities": [
    "stopwatch.read",
    "stopwatch.control"
   ]
  },
  "wrapper": {
   "menu": [
    {
     "type": "toggle",
     "id": "seconds",
     "label": {
      "en": "Seconds",
      "fr": "Secondes"
     },
     "default": false
    },
    {
     "type": "slider",
     "id": "size",
     "label": {
      "en": "Size",
      "fr": "Taille"
     },
     "min": 1,
     "max": 5,
     "step": 1,
     "default": 3
    },
    {
     "type": "choice",
     "id": "style",
     "label": {
      "en": "Style",
      "fr": "Style"
     },
     "choices": [
      {
       "value": "plain",
       "label": {
        "en": "Plain",
        "fr": "Simple"
       }
      },
      {
       "value": "bold",
       "label": {
        "en": "Bold",
        "fr": "Gras"
       }
      }
     ],
     "default": "plain"
    },
    {
     "type": "action",
     "id": "add-zone",
     "label": {
      "en": "Add",
      "fr": "Ajouter"
     }
    }
   ]
  }
 },
