/* One declaration of every property of the schema, with a non-trivial value. */

.first {
  display: grid;
  position: absolute;
  top: -4px;
  right: 10%;
  bottom: auto;
  left: var(--space-2);
  flex-direction: column-reverse;
  flex-wrap: wrap;
  flex-grow: 1.5;
  flex-shrink: 0;
  flex-basis: 40%;
  justify-content: space-between;
  align-items: baseline;
  align-self: auto;
  align-content: space-evenly;
  justify-items: center;
  justify-self: end;
  gap: 4px 2%;
  row-gap: var(--space-3);
  column-gap: 0;
  grid-template-columns: repeat(3, minmax(40px, 1fr));
  grid-template-rows: auto 1fr max-content 24px;
  grid-auto-flow: column;
  grid-auto-columns: minmax(min-content, 2fr);
  grid-auto-rows: var(--control-height);
  grid-column: 1 / span 2;
  grid-row: span 3;
  width: 100%;
  height: var(--control-height);
  min-width: 0;
  min-height: auto;
  max-width: 480px;
  max-height: none;
  aspect-ratio: 1.5;
  margin: 0 auto;
  margin-top: -2px;
  margin-right: auto;
  margin-bottom: 5%;
  margin-left: var(--space-1);
  padding: var(--space-2) var(--space-4) 6px;
}

box > .second:hover {
  padding-top: 1px;
  padding-right: 2%;
  padding-bottom: 0;
  padding-left: var(--space-5);
  overflow: hidden;
  background-color: rgb(24 24 28 / 88%);
  background: linear-gradient(135deg, var(--color-accent), #0000 60%, rgb(0 0 0 / 0.5) 100%);
  border: 1px solid var(--color-border);
  border-top: 0;
  border-right: 2px none;
  border-bottom: 1px #fff;
  border-left: var(--space-1) solid currentColor;
  border-width: 1px 0;
  border-style: solid;
  border-color: var(--color-border-strong);
  border-radius: var(--radius-md) 50% 4px;
  box-shadow: inset 0 1px 2px #0008, 0 0 0 1px var(--color-border);
  opacity: 0.75;
  visibility: hidden;
  object-fit: cover;
  color: var(--color-text-muted);
  font-family: var(--font-mono);
  font-size: var(--font-size-small);
  font-weight: 600;
  font-style: italic;
  font-variant-numeric: tabular-nums;
  line-height: 1.3;
  letter-spacing: -0.5px;
  text-align: center;
  text-decoration: underline;
  text-transform: uppercase;
  white-space: pre-wrap;
  text-overflow: ellipsis;
  vertical-align: middle;
  line-clamp: 2;
  overflow-wrap: anywhere;
  transform: translate(4px, -50%) scale(1.2, 0.8) rotate(-0.25turn) translateY(2px);
  transform-origin: left 25%;
  transition: opacity var(--duration-fast) ease-out, color 0.2s steps(4) 50ms;
  animation: pulse 2s ease-in-out 0.5s infinite alternate both, fade var(--duration-medium);
  cursor: pointer;
  pointer-events: none;
}

@keyframes pulse {
  from { opacity: 1; }
  50% { opacity: 0.4; transform: scale(0.9); }
  to { opacity: 1; }
}

@keyframes fade {
  0%, 100% { opacity: 0; }
  40% { background-color: var(--color-accent-soft); }
}
