{
  "schemaVersion": 1,
  "apiVersion": 1,
  "id": "nova.steam-progress",
  "version": "1.0.0",
  "name": {
    "en": "Steam progress",
    "fr": "Progression Steam"
  },
  "sizing": {
    "fit": "height",
    "preferred": {
      "width": 300,
      "height": 170
    },
    "min": {
      "width": 200,
      "height": 96
    },
    "max": {
      "width": 480,
      "height": 480
    }
  },
  "permissions": {
    "accounts": [
      {
        "id": "runlog",
        "name": "Run Log",
        "mode": "key",
        "origins": [
          "https://api.steampowered.com"
        ],
        "send": {
          "header": "X-Api-Key"
        },
        "key": {
          "format": {
            "charset": "alnum",
            "minLength": 16,
            "maxLength": 64
          },
          "page": "https://runlog.example/settings/api"
        }
      }
    ],
    "network": [
      {
        "origin": "https://api.steampowered.com",
        "method": "GET",
        "path": "/v1/runs",
        "account": "runlog"
      }
    ]
  }
}
