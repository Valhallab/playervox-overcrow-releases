{
  "schemaVersion": 1,
  "apiVersion": 1,
  "id": "nova.steam-stats",
  "version": "1.0.0",
  "name": {
    "en": "Steam stats",
    "fr": "Stats Steam"
  },
  "sizing": {
    "fit": "height",
    "preferred": {
      "width": 300,
      "height": 170
    },
    "min": {
      "width": 280,
      "height": 140
    },
    "max": {
      "width": 480,
      "height": 480
    }
  },
  "permissions": {
    "storage": true,
    "accounts": [
      {
        "id": "runlog",
        "name": "Run Log",
        "mode": "key",
        "origins": [
          "https://api.runlog.example",
          "https://img.runlog.example"
        ],
        "send": {
          "query": "key"
        },
        "key": {
          "format": {
            "charset": "hex",
            "minLength": 32,
            "maxLength": 32
          },
          "page": "https://runlog.example/settings/api"
        },
        "refusedStatus": [
          401,
          403
        ]
      }
    ],
    "network": [
      {
        "origin": "https://api.runlog.example",
        "method": "GET",
        "path": "/ISteamUser/GetPlayerSummaries/v2/",
        "queryParams": {
          "steamids": {
            "type": "slug",
            "maxLength": 17,
            "required": true
          },
          "key": {
            "type": "slug",
            "maxLength": 32
          }
        },
        "maxResponseBytes": 65536,
        "account": "runlog"
      },
      {
        "origin": "https://img.runlog.example",
        "method": "GET",
        "path": "/{file}",
        "pathParams": {
          "file": {
            "type": "slug",
            "maxLength": 64
          }
        }
      }
    ]
  }
}
