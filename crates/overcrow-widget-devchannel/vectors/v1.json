{
  "comment": "Development channel v1 test vectors (docs/dev-channel.md). A frame is a big-endian u32 length followed by `header`; `length` overrides the length when present; `payload` (ASCII) follows the header. `expect` is ok, closed, eof, frameSize, malformed, digest or invalid:<field>.",
  "client": [
    {"name": "hello", "header": "{\"type\":\"hello\",\"protocol\":1,\"client\":\"overcrow-widget 0.1.0\"}", "expect": "ok"},
    {"name": "hello of a future version parses (refused later)", "header": "{\"type\":\"hello\",\"protocol\":2,\"client\":\"overcrow-widget 9.0.0\"}", "expect": "ok"},
    {"name": "hello with an extra field", "header": "{\"type\":\"hello\",\"protocol\":1,\"client\":\"x\",\"features\":[]}", "expect": "malformed"},
    {"name": "hello with a control character in the name", "header": "{\"type\":\"hello\",\"protocol\":1,\"client\":\"a\\u001bb\"}", "expect": "invalid:client"},
    {"name": "hello with an empty name", "header": "{\"type\":\"hello\",\"protocol\":1,\"client\":\"\"}", "expect": "invalid:client"},
    {"name": "status", "header": "{\"type\":\"status\",\"request\":7}", "expect": "ok"},
    {"name": "request zero", "header": "{\"type\":\"status\",\"request\":0}", "expect": "invalid:request"},
    {"name": "negative request", "header": "{\"type\":\"status\",\"request\":-1}", "expect": "malformed"},
    {"name": "remove", "header": "{\"type\":\"remove\",\"request\":2,\"id\":\"com.example.clock\"}", "expect": "ok"},
    {"name": "remove of an invalid ID", "header": "{\"type\":\"remove\",\"request\":2,\"id\":\"../etc\"}", "expect": "invalid:id"},
    {"name": "remove by path is not a message", "header": "{\"type\":\"remove\",\"request\":2,\"path\":\"/tmp/widget\"}", "expect": "malformed"},
    {"name": "install from a path is not a message", "header": "{\"type\":\"install\",\"request\":1,\"path\":\"/tmp/widget\"}", "expect": "malformed"},
    {"name": "install with a source field", "header": "{\"type\":\"install\",\"request\":1,\"packageBytes\":3,\"sha256\":\"ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad\",\"source\":\"/tmp\"}", "payload": "abc", "expect": "malformed"},
    {"name": "install", "header": "{\"type\":\"install\",\"request\":1,\"packageBytes\":3,\"sha256\":\"ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad\"}", "payload": "abc", "expect": "ok"},
    {"name": "install whose bytes do not match", "header": "{\"type\":\"install\",\"request\":1,\"packageBytes\":3,\"sha256\":\"ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad\"}", "payload": "abd", "expect": "digest"},
    {"name": "install cut short", "header": "{\"type\":\"install\",\"request\":1,\"packageBytes\":3,\"sha256\":\"ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad\"}", "payload": "ab", "expect": "eof"},
    {"name": "install of an empty package", "header": "{\"type\":\"install\",\"request\":1,\"packageBytes\":0,\"sha256\":\"e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855\"}", "expect": "invalid:package_bytes"},
    {"name": "install above the package bound", "header": "{\"type\":\"install\",\"request\":1,\"packageBytes\":16777217,\"sha256\":\"ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad\"}", "expect": "invalid:package_bytes"},
    {"name": "install with an uppercase digest", "header": "{\"type\":\"install\",\"request\":1,\"packageBytes\":3,\"sha256\":\"BA7816BF8F01CFEA414140DE5DAE2223B00361A396177A9CB410FF61F20015AD\"}", "payload": "abc", "expect": "invalid:sha256"},
    {"name": "install with snake_case fields", "header": "{\"type\":\"install\",\"request\":1,\"package_bytes\":3,\"sha256\":\"ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad\"}", "payload": "abc", "expect": "malformed"},
    {"name": "unknown type", "header": "{\"type\":\"replay\",\"request\":1}", "expect": "malformed"},
    {"name": "no type", "header": "{\"request\":1}", "expect": "malformed"},
    {"name": "duplicate field", "header": "{\"type\":\"status\",\"request\":1,\"request\":2}", "expect": "malformed"},
    {"name": "not an object", "header": "[\"status\",1]", "expect": "malformed"},
    {"name": "not UTF-8 JSON", "header": "\u00ff", "expect": "malformed"},
    {"name": "trailing bytes after the object", "header": "{\"type\":\"status\",\"request\":1} {}", "expect": "malformed"},
    {"name": "zero length", "header": "", "length": 0, "expect": "frameSize"},
    {"name": "length above the header bound", "header": "{}", "length": 16385, "expect": "frameSize"},
    {"name": "length above the data", "header": "{\"type\":\"status\",\"request\":1}", "length": 64, "expect": "eof"},
    {"name": "nothing", "raw": "", "expect": "closed"},
    {"name": "cut inside the length", "raw": "0000", "expect": "eof"}
  ],
  "server": [
    {"name": "welcome", "header": "{\"type\":\"welcome\",\"protocol\":1,\"overlay\":\"overcrow 0.9.0\",\"platform\":\"linux\",\"limits\":{\"maxHeaderBytes\":16384,\"maxPackageBytes\":16777216,\"maxSessions\":4,\"requestsPerSecond\":10,\"requestBurst\":20}}", "expect": "ok"},
    {"name": "refused, unsupported protocol", "header": "{\"type\":\"refused\",\"code\":\"unsupported_protocol\",\"supported\":[1]}", "expect": "ok"},
    {"name": "refused with an invalid code", "header": "{\"type\":\"refused\",\"code\":\"Bad Code\"}", "expect": "invalid:value"},
    {"name": "install accepted", "header": "{\"type\":\"result\",\"request\":1,\"ok\":true,\"id\":\"com.example.clock\",\"sha256\":\"ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad\"}", "expect": "ok"},
    {"name": "install refused", "header": "{\"type\":\"result\",\"request\":1,\"ok\":false,\"code\":\"reserved_id\"}", "expect": "ok"},
    {"name": "a failure without a code", "header": "{\"type\":\"result\",\"request\":1,\"ok\":false}", "expect": "invalid:value"},
    {"name": "status", "header": "{\"type\":\"status\",\"request\":3,\"widgets\":[{\"id\":\"com.example.clock\",\"state\":\"restarting\",\"failure\":\"heap_exhausted\"}]}", "expect": "ok"},
    {"name": "event installed", "header": "{\"type\":\"event\",\"kind\":\"installed\",\"id\":\"com.example.clock\"}", "expect": "ok"},
    {"name": "event failed", "header": "{\"type\":\"event\",\"kind\":\"failed\",\"code\":\"invalid_bundle\"}", "expect": "ok"},
    {"name": "event failed without a code", "header": "{\"type\":\"event\",\"kind\":\"failed\"}", "expect": "invalid:value"},
    {"name": "state", "header": "{\"type\":\"state\",\"id\":\"com.example.clock\",\"state\":\"running\"}", "expect": "ok"},
    {"name": "log with escapes the client must neutralize", "header": "{\"type\":\"log\",\"id\":\"com.example.clock\",\"generation\":1,\"level\":\"warn\",\"text\":\"\\u001b]52;c;aGk=\\u0007\"}", "expect": "ok"},
    {"name": "log of an unknown level", "header": "{\"type\":\"log\",\"id\":\"com.example.clock\",\"generation\":1,\"level\":\"trace\",\"text\":\"x\"}", "expect": "malformed"},
    {"name": "dropped", "header": "{\"type\":\"dropped\",\"count\":12}", "expect": "ok"},
    {"name": "dropped nothing", "header": "{\"type\":\"dropped\",\"count\":0}", "expect": "invalid:value"},
    {"name": "unknown field", "header": "{\"type\":\"dropped\",\"count\":1,\"more\":true}", "expect": "malformed"}
  ]
}
