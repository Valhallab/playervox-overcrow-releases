{
  "schemaVersion": 1,
  "apiVersion": 1,
  "id": "com.example.sdk-stopwatch",
  "version": "1.0.0",
  "name": {
    "en": "SDK Stopwatch",
    "fr": "Chronomètre SDK"
  },
  "sizing": {
    "fit": "both",
    "preferred": { "width": 180, "height": 96 },
    "min": { "width": 120, "height": 60 },
    "max": { "width": 360, "height": 240 }
  },
  "permissions": {
    "capabilities": ["stopwatch.read", "stopwatch.control"]
  },
  "wrapper": {
    "menu": [
      {
        "type": "action",
        "id": "toggle",
        "icon": "play",
        "label": { "en": "Start or stop", "fr": "Démarrer ou arrêter" }
      }
    ]
  }
}
