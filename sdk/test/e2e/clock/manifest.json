{
  "schemaVersion": 1,
  "apiVersion": 1,
  "id": "com.example.sdk-clock",
  "version": "1.0.0",
  "name": {
    "en": "SDK Clock",
    "fr": "Horloge SDK"
  },
  "sizing": {
    "fit": "both",
    "preferred": { "width": 200, "height": 120 },
    "min": { "width": 120, "height": 60 },
    "max": { "width": 480, "height": 320 }
  },
  "wrapper": {
    "menu": [
      {
        "type": "toggle",
        "id": "seconds",
        "icon": "clock",
        "label": { "en": "Show seconds", "fr": "Afficher les secondes" },
        "default": false
      },
      {
        "type": "action",
        "id": "add-zone",
        "icon": "plus",
        "label": { "en": "Add a zone", "fr": "Ajouter un fuseau" }
      }
    ]
  }
}
