{
  "scenarioVersion": 1,
  "name": "dst",
  "description": "Summer time starts at 01:00 UTC on 2026-03-29 (UTC+1 to UTC+2): the host sends the new Region at region.nextChangeAt and the minute tick shows 03:00.",
  "host": {
    "locale": "fr",
    "zone": {
      "offsetMinutes": 60,
      "transitions": [{ "at": 1774746000000, "offsetMinutes": 120 }]
    },
    "startAt": 1774745940000
  },
  "steps": [
    { "expect": { "text": ["01:59", "29/03/2026", "00:59 UTC+0"], "image": "before" } },
    { "advance": { "ms": 60000 } },
    { "expect": { "text": ["03:00", "01:00 UTC+0"], "noText": ["02:00"], "image": "after" } },
    { "advance": { "ms": 120000 } },
    { "expect": { "text": ["03:02", "01:02 UTC+0"], "fault": "none" } }
  ]
}
