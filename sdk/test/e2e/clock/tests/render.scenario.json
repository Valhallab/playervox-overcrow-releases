{
  "scenarioVersion": 1,
  "name": "render",
  "description": "The clock at two fixed times (UTC+1), dark and light, English and French, at 100 % and 150 %.",
  "host": {
    "locale": "en",
    "theme": "dark",
    "scale": 1000,
    "zone": { "offsetMinutes": 60 },
    "startAt": 1767268800000
  },
  "steps": [
    { "expect": { "state": "running", "text": ["13:00", "12:00 UTC+0"], "image": "noon-dark-en-100" } },
    { "host": { "theme": "light" } },
    { "expect": { "image": "noon-light-en-100" } },
    { "host": { "locale": "fr" } },
    { "expect": { "text": ["13:00"], "image": "noon-light-fr-100" } },
    { "host": { "theme": "dark" } },
    { "expect": { "image": "noon-dark-fr-100" } },
    { "host": { "scale": 1500 } },
    { "expect": { "image": "noon-dark-fr-150" } },
    { "host": { "theme": "light" } },
    { "expect": { "image": "noon-light-fr-150" } },
    { "host": { "locale": "en" } },
    { "expect": { "image": "noon-light-en-150" } },
    { "host": { "theme": "dark" } },
    { "expect": { "image": "noon-dark-en-150" } },
    { "advance": { "ms": 34200000, "jump": true } },
    { "expect": { "text": ["22:30", "21:30 UTC+0"], "image": "evening-dark-en-150" } },
    { "host": { "theme": "light" } },
    { "expect": { "image": "evening-light-en-150" } },
    { "host": { "locale": "fr" } },
    { "expect": { "text": ["22:30"], "image": "evening-light-fr-150" } },
    { "host": { "theme": "dark" } },
    { "expect": { "image": "evening-dark-fr-150" } },
    { "host": { "scale": 1000 } },
    { "expect": { "image": "evening-dark-fr-100" } },
    { "host": { "theme": "light" } },
    { "expect": { "image": "evening-light-fr-100" } },
    { "host": { "locale": "en" } },
    { "expect": { "image": "evening-light-en-100" } },
    { "host": { "theme": "dark" } },
    { "expect": { "image": "evening-dark-en-100", "fault": "none" } }
  ]
}
