.clock {
  flex-direction: column;
  align-items: start;
  gap: var(--space-1);
  padding: var(--space-3);
}

.time {
  font-size: var(--font-size-value);
  font-variant-numeric: tabular-nums;
}

.date,
.zone {
  color: var(--color-text-muted);
  font-variant-numeric: tabular-nums;
}

.dial {
  width: 32px;
  height: 32px;
}
