{
  "schemaVersion": 1,
  "apiVersion": 1,
  "id": "nova.quest-log",
  "version": "1.0.0",
  "name": { "en": "Quest log", "fr": "Journal de quêtes" },
  "sizing": {
    "fit": "none",
    "preferred": { "width": 240, "height": 110 },
    "min": { "width": 180, "height": 90 },
    "max": { "width": 480, "height": 320 }
  },
  "permissions": {
    "accounts": [
      {
        "id": "quests",
        "name": "Quest Log",
        "mode": "oauth",
        "required": false,
        "origins": ["https://api.quests.example", "https://quests.example"],
        "oauth": {
          "clientId": "nova-overcrow-widget",
          "flow": "loopback",
          "authorize": "https://quests.example/oauth/authorize",
          "token": "https://quests.example/oauth/token",
          "revoke": "https://quests.example/oauth/revoke",
          "scopes": [{ "name": "quests:read", "access": "read" }]
        }
      }
    ],
    "network": [
      {
        "origin": "https://api.quests.example",
        "method": "GET",
        "path": "/v1/me/quests",
        "queryParams": { "status": { "type": "enum", "values": ["active", "done"] } },
        "maxResponseBytes": 32768,
        "account": "quests"
      }
    ]
  }
}
