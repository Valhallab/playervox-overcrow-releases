{
  "schemaVersion": 1,
  "apiVersion": 1,
  "id": "nova.steam-stats",
  "version": "1.0.0",
  "name": { "en": "Steam stats", "fr": "Stats Steam" },
  "sizing": {
    "fit": "none",
    "preferred": { "width": 260, "height": 120 },
    "min": { "width": 200, "height": 96 },
    "max": { "width": 480, "height": 320 }
  },
  "permissions": {
    "accounts": [
      {
        "id": "steam",
        "name": "Steam",
        "mode": "key",
        "origins": ["https://api.steampowered.com"],
        "send": { "header": "X-WebAPI-Key" },
        "key": {
          "format": { "charset": "hex", "minLength": 32, "maxLength": 32 },
          "page": "https://steamcommunity.com/dev/apikey"
        },
        "refusedStatus": [401, 403]
      }
    ],
    "network": [
      {
        "origin": "https://api.steampowered.com",
        "method": "GET",
        "path": "/ISteamUser/GetPlayerSummaries/v2/",
        "queryParams": {
          "steamids": { "type": "slug", "maxLength": 17, "required": true }
        },
        "maxResponseBytes": 16384,
        "account": "steam"
      }
    ],
    "storage": true
  }
}
