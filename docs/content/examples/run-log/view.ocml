<!-- The player's latest run. The key is entered in OverCrow's own panel. -->
<box class="stats">
  <text class="game">{state.game}</text>
  <text class="time">{state.time}</text>
  <box class="footer">
    <text class="status">{t(state.status)}</text>
    <if test={state.run != ""}>
      <button class="refresh" label={t("open")} on:activate={openRun}>
        <icon name="external-link"/>
      </button>
    </if>
    <button class="refresh" label={t("refresh")} on:activate={refresh}>
      <icon name="refresh-cw"/>
    </button>
  </box>
</box>
