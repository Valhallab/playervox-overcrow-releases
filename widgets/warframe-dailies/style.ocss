/* Warframe dailies and weeklies. The first rules are the panel, header and
   type scale the PlayerVox Warframe widgets share. */
/* The frame: never taller than the user's height (manual size). */
.checklist {
  flex-direction: column;
  width: 100%;
  max-height: 100%;
}

/* The panel stops at the frame's largest height (the manifest's): beyond,
   the lists scroll in Interactive and Nightwave folds in Passive. */
.wf {
  flex-direction: column;
  width: 100%;
  /* The manifest's largest height: past it, the list shrinks and scrolls,
     the note and the bottom margin stay whole. */
  max-height: 520px;
  min-height: 0;
  flex-shrink: 1;
  padding: 10px;
  gap: 6px;
}

.body {
  flex-direction: column;
  min-height: 0;
  flex-shrink: 1;
  overflow: hidden;
}

/* The host's scrollbar sits over the right edge: the lists keep their
   place, 9 px clear of it. */
scroll.body {
  margin-right: -9px;
  padding-right: 9px;
}

.grow {
  flex-grow: 1;
  flex-shrink: 1;
  min-width: 0;
}

/* Header: the context in capitals, then one short value on the right. */
.eyebrow-row {
  flex-direction: row;
  align-items: center;
  gap: 5px;
  min-height: 14px;
}

.eyebrow {
  font-size: var(--font-size-caption);
  font-weight: 700;
  letter-spacing: 1.2px;
  text-transform: uppercase;
  color: var(--color-text-muted);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  flex-shrink: 1;
  min-width: 0;
}

.eyebrow-icon {
  font-size: 11px;
  color: var(--color-text-muted);
  flex-shrink: 0;
}

.tone-accent { color: var(--color-accent); }

.tone-success { color: var(--color-success); }

.tone-danger { color: var(--color-danger); }

.tone-warning { color: var(--color-warning); }

.tone-muted { color: var(--color-text-muted); }

.meta-sep {
  font-size: var(--font-size-small);
  color: var(--color-text-subtle);
}

.notice-icon {
  font-size: 14px;
  margin-top: 1px;
  flex-shrink: 0;
}

.notice-text {
  font-size: var(--font-size-small);
  color: var(--color-text-muted);
}

.empty {
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6px;
  padding: 12px 8px;
}

.empty-icon {
  font-size: 20px;
  color: var(--color-text-muted);
}

.empty-title {
  font-size: 13px;
  font-weight: 600;
  text-align: center;
}

.empty-text {
  font-size: var(--font-size-small);
  color: var(--color-text-muted);
  text-align: center;
}

.status-line {
  flex-direction: row;
  align-items: center;
  gap: 5px;
}

.status-icon {
  font-size: 11px;
  color: var(--color-text-muted);
}

.status-text {
  font-size: var(--font-size-caption);
  color: var(--color-text-muted);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  flex-shrink: 1;
  min-width: 0;
}

/* One-line (mini) layout. */
.line {
  flex-direction: row;
  align-items: center;
  gap: 6px;
  min-height: 40px;
  min-width: 0;
  overflow: hidden;
  padding: 0 10px;
}

.line-icon {
  font-size: 14px;
  flex-shrink: 0;
}

.line-main {
  font-size: 13px;
  font-weight: 600;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  flex-shrink: 1;
  min-width: 0;
}

.section-title {
  font-size: var(--font-size-caption);
  font-weight: 700;
  letter-spacing: 1px;
  text-transform: uppercase;
  color: var(--color-text-muted);
}

/* State colours win over the base colour of these icons. */
.empty-icon.tone-warning,
.status-icon.tone-warning,
.line-reset.tone-warning,
.line .line-main.tone-warning { color: var(--color-warning); }

.empty-icon.tone-danger { color: var(--color-danger); }

.empty-icon.tone-success { color: var(--color-success); }

.checklist.line {
  padding: 0;
}

.left {
  font-size: 13px;
  font-weight: 700;
  white-space: nowrap;
}

.left.all {
  color: var(--color-success);
}

.hint-box {
  flex-direction: row;
  align-items: start;
  gap: 7px;
}

.hint-box .notice-icon {
  font-size: 12px;
  margin-top: 2px;
}

.hint-box .notice-text {
  flex-shrink: 1;
  min-width: 0;
  font-size: 12px;
}

/* The columns. Today and This week are spaced by `.gcol`'s gap. */
.groups {
  flex-direction: column;
  gap: 10px;
}

.wide .groups {
  flex-direction: row;
  align-items: start;
  gap: 16px;
}

.group {
  flex-direction: column;
}

.group-head {
  flex-direction: row;
  align-items: baseline;
  gap: 6px;
  padding-bottom: 4px;
  border-bottom: 1px solid var(--color-border);
}

/* The reset is a number that counts: as readable as the rows. */
.reset {
  font-size: 12px;
  font-weight: 400;
  font-variant-numeric: tabular-nums;
  color: var(--color-text-secondary);
  white-space: nowrap;
}

.check-icon {
  font-size: 16px;
  flex-shrink: 0;
  margin-top: 1px;
}

.check-icon.todo {
  color: var(--color-text-muted);
}

.check-icon.started {
  color: var(--color-text-secondary);
}

.check-icon.done {
  color: var(--color-success);
}

.row-value {
  font-size: 13px;
  font-weight: 600;
  font-variant-numeric: tabular-nums;
  color: var(--color-text-secondary);
  white-space: nowrap;
  flex-shrink: 0;
}

.row-value.when {
  margin-top: 2px;
  font-size: var(--font-size-small);
  font-weight: 400;
  color: var(--color-text-muted);
}

.row-value.when.tone-success {
  color: var(--color-success);
  font-weight: 600;
}

.hand {
  font-size: 12px;
  color: var(--color-text-secondary);
  flex-shrink: 0;
  margin-top: 4px;
}

/* Baro is not a task: one quiet line under the lists. */
.foot {
  flex-direction: row;
  align-items: center;
  gap: 6px;
  padding-top: 4px;
  border-top: 1px solid var(--color-border);
}

.foot-icon {
  font-size: 12px;
  color: var(--color-text-muted);
  flex-shrink: 0;
}

.foot-text {
  font-size: var(--font-size-small);
  color: var(--color-text-muted);
  flex-shrink: 1;
  min-width: 0;
}

.line-reset {
  font-size: 12px;
  font-weight: 400;
  color: var(--color-text-secondary);
  font-variant-numeric: tabular-nums;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  flex-shrink: 1;
  min-width: 0;
}

.foot-icon.here {
  color: var(--color-text-secondary);
}

.foot-text.here {
  color: var(--color-text-secondary);
  font-weight: 600;
}

.foot-icon,
.status-icon {
  width: 12px;
}

/* The count never shrinks: what follows it ends with "…" first. */
.line .line-main {
  font-weight: 700;
  flex-shrink: 0;
}

/* A box per part. */
.acts {
  flex-direction: column;
  gap: 1px;
}

.act {
  flex-direction: column;
  padding: 2px 0 0 0;
}

.act-head {
  flex-direction: row;
  align-items: center;
  gap: 8px;
  min-height: 20px;
}

.act-btn {
  cursor: pointer;
  border-radius: 4px;
}

.act-btn:hover,
.act-btn:focus {
  background: var(--color-surface-hover);
}

.act-name {
  font-size: 13px;
  font-weight: 600;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  flex-shrink: 1;
  min-width: 0;
}

.act.done .act-name {
  color: var(--color-text-muted);
  font-weight: 400;
}

/* Under the name: indented to the name's column. */
.act-body {
  flex-direction: column;
  padding-left: 24px;
  gap: 1px;
}

.meta-row {
  flex-direction: row;
  align-items: center;
  gap: 5px;
  min-height: 18px;
}

.shard {
  width: 18px;
  height: 18px;
  flex-shrink: 0;
}

.act-meta {
  font-size: var(--font-size-small);
  color: var(--color-text-muted);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  flex-shrink: 1;
  min-width: 0;
}

.sub-title {
  font-size: 10px;
  font-weight: 600;
  letter-spacing: 0.6px;
  text-transform: uppercase;
  color: var(--color-text-muted);
  margin-top: 2px;
}

.parts {
  flex-direction: column;
}

.cells {
  flex-direction: row;
  gap: 2px;
  padding-top: 1px;
}

.part {
  flex-direction: row;
  align-items: center;
  gap: 6px;
  min-height: 17px;
  padding: 0 4px 0 2px;
  margin-left: -2px;
  border-radius: 4px;
}

.cells .part {
  padding: 2px 3px;
  margin-left: 0;
  gap: 0;
}

button.part {
  cursor: pointer;
}

button.part:hover,
button.part:focus {
  background: var(--color-surface-hover);
}

.part-icon {
  font-size: 13px;
  flex-shrink: 0;
  color: var(--color-text-muted);
}

.cells .part-icon {
  font-size: 15px;
}

.part-icon.done {
  color: var(--color-success);
}

.part-icon.part-going {
  color: var(--color-text-secondary);
}

.part-text {
  font-size: 12px;
  color: var(--color-text-secondary);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  flex-shrink: 1;
  min-width: 0;
}

.part-text.done {
  color: var(--color-text-muted);
  text-decoration: line-through;
}

/* Not the final text yet (a Sortie stage before its type is known, a
   stage before the world is read): the muted grey of the theme, nothing
   added. */
.part-text.pending {
  color: var(--color-text-muted);
}

/* Set by hand against the game: always in the right column, 14 px. */
.part .hand,
.act-head .hand {
  font-size: 14px;
  width: 14px;
  margin-top: 0;
  color: var(--color-text-secondary);
}

.choices {
  flex-direction: row;
  flex-wrap: wrap;
  align-items: center;
  column-gap: 5px;
  row-gap: 1px;
  min-height: 18px;
}

.choice {
  font-size: 12px;
  color: var(--color-text-secondary);
  white-space: nowrap;
}

/* The week's pick: positive green in an outlined chip (never read as
   "done"), never the accent; the others grey. */
.choice.picked {
  color: var(--color-success);
  font-weight: 600;
  padding: 0 6px;
  border-radius: 9px;
  border: 1px solid var(--color-success);
}

/* A choice not picked: muted, still readable (it stays clickable). */
.choice.other {
  color: var(--color-text-muted);
}

.choice-sep {
  font-size: 12px;
  color: var(--color-text-muted);
}

.note-row {
  flex-direction: row;
  align-items: start;
  gap: 6px;
  padding-top: 4px;
  border-top: 1px solid var(--color-border);
}

.note-icon {
  font-size: 11px;
  color: var(--color-text-muted);
  flex-shrink: 0;
}

/* Two lines at most: what ticks itself, and what to do otherwise. */
.note-text {
  font-size: var(--font-size-small);
  color: var(--color-text-muted);
  flex-shrink: 1;
  min-width: 0;
}

/* Every state icon takes the same width: the names stay in one column. */
.act-head .check-icon {
  margin-top: 0;
}

/* Icons sit in a fixed slot: every status icon on the same centre, whatever its shape. */
.ico-slot {
  width: 14px;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
}

.head-slot {
  width: 16px;
}

.cells .ico-slot {
  width: 16px;
}

.gcol {
  flex-direction: column;
  gap: 10px;
  min-width: 0;
}

.wide .gcol {
  flex-grow: 1;
  flex-basis: 0;
}

.act-head .shard {
  width: 16px;
  height: 16px;
  flex-shrink: 0;
}

.act-head .meta-sep {
  font-size: 12px;
  color: var(--color-text-muted);
}

.act-head .act-meta {
  font-size: 12px;
}

.wide .gcol .group {
  flex-grow: 0;
  flex-basis: auto;
}

.note-row .note-icon {
  margin-top: 2px;
}

/* Interactive: every name is a button; the same padding picked or not, so
   that a click never moves the others. */
.choice-btn {
  flex-direction: row;
  align-items: center;
  padding: 0 5px;
  border-radius: 9px;
  border: 1px solid transparent;
  cursor: pointer;
  background: transparent;
}

.choice-btn:hover,
.choice-btn:focus {
  background: var(--color-surface-hover);
}

.choice-btn.picked {
  border: 1px solid var(--color-success);
}

.choice-text {
  font-size: 12px;
  white-space: nowrap;
}

.choice-btn.picked .choice-text {
  color: var(--color-success);
  font-weight: 600;
}

.choice-btn.other .choice-text {
  color: var(--color-text-muted);
}

.choices .hand {
  font-size: 14px;
  width: 14px;
  color: var(--color-text-secondary);
}

.cells .hand {
  font-size: 14px;
  width: 14px;
  color: var(--color-text-secondary);
}

/* Interactive: the buttons' own padding spaces the names, without dots. */
.live .choices {
  column-gap: 3px;
  margin-left: -5px;
}

/* The Archon Shard when its image will not come: our icon. */
.shard-glyph {
  font-size: 13px;
  color: var(--color-text-muted);
  flex-shrink: 0;
}

/* Passive: what a long Nightwave list folds at its end. */
.more {
  font-size: var(--font-size-small);
  color: var(--color-text-muted);
  min-height: 17px;
  padding-left: 2px;
}
