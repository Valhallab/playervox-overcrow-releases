            },
            "outcome": "ok"
          },
          {
            "service": "twitch.events.subscribe",
            "params": {},
            "outcome": "ok"
          }
        ]
      }
    },
    {
      "advance": {
        "ms": 120000
      }
    },
    {
      "host": {
        "locale": "fr",
        "region": {
          "numberFormat": "fr",
          "dateOrder": "dmy"
        }
      }
    },
    {
      "expect": {
        "image": "signed-out-fr",
        "fault": "none",
        "calls": []
      }
    }
  ]
