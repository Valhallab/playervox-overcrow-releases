{
  "scenarioVersion": 1,
  "name": "signed-out",
  "description": "Twitch not connected (or connected without this widget's permissions): the host's panel, the widget reads nothing.",
  "host": {
    "startAt": 1767225600000,
    "frame": true,
    "accounts": {
      "twitch": "disconnected"
    }
  },
  "fixtures": {
    "http": [],
    "subscriptions": {
      "twitch.events.subscribe": {
        "state": "off",
        "reason": "connecting",
        "events": []
      }
    }
  },
  "steps": [
