<!-- FPS: the game's presented frame rate, observed from outside the game
     (parity sheet: playervox-overcrow docs/builtin-parity/fps.md). One text
     keeps the value and the unit on one baseline. -->
<box class="fps" label={fpsLabel(state.fps)} tooltip={fpsTooltip(state.status)}>
  <text class="line">
    <span class={valueClass(state.fps)}>{fpsValue(state.fps)}</span>
    <if test={state.showLabel}>
      <span class="small">&nbsp;&nbsp;FPS</span>
    </if>
  </text>
</box>
