/* One line; the wrapper draws the panel and its 8 px margin, the content
   adds 2 px on the sides: the built-in's 10 × 8 px margin. */
.fps {
  flex-direction: column;
  align-items: start;
  padding: 0 2px;
}

.line {
  font-family: var(--font-ui);
  font-variant-numeric: tabular-nums;
  color: var(--color-text-muted);
  white-space: nowrap;
}

/* A value is primary; no value is muted. */
.value {
  font-size: var(--font-size-value);
  color: var(--color-text);
}

.value.muted {
  color: var(--color-text-muted);
}

/* The unit: 12 px semibold, between the small and button sizes, as the
   built-in drew it. */
.small {
  font-size: 12px;
  font-weight: 600;
}
