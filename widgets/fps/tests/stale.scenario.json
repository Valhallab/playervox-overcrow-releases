{
  "scenarioVersion": 1,
  "name": "stale",
  "description": "The host keeps the reading through a gap of its capture and marks it stale: the number stays exactly as it was, with no sign of its age; a new sample replaces it.",
  "fixtures": {
    "subscriptions": {
      "fps.subscribe": {
        "fps": 144,
        "stale": false,
        "status": "ready"
      }
    }
  },
  "steps": [
    {
      "publish": {
        "service": "fps.subscribe",
        "value": {
          "fps": 144,
          "stale": true,
          "status": "ready"
        }
      }
    },
    {
      "expect": {
        "text": [
          "144"
        ],
        "image": "kept-dark-en",
        "noText": [
          "old",
          "ancien"
        ]
      }
    },
    {
      "host": {
        "theme": "light"
      }
    },
    {
      "expect": {
        "image": "kept-light-en"
      }
    },
    {
      "host": {
        "locale": "fr",
        "theme": "dark"
      }
    },
    {
      "expect": {
        "image": "kept-dark-fr"
      }
    },
    {
      "host": {
        "scale": 1500,
        "theme": "light"
      }
    },
    {
      "expect": {
        "image": "kept-light-fr-150"
      }
    },
    {
      "publish": {
        "service": "fps.subscribe",
        "value": {
          "fps": 60,
          "stale": false,
          "status": "ready"
        }
      }
    },
    {
      "expect": {
        "text": [
          "60"
        ],
        "noText": [
          "144"
        ],
        "fault": "none"
      }
    }
  ]
}
