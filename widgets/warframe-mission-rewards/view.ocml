<!-- Warframe mission rewards: the next rotation, and what it can give. -->
<component name="drops" props="items">
  <for each={items} as="d" key={d.id}>
    <box class="drop">
      <box class="thumb">
        <if test={hasText(d.icon)}>
          <image class="thumb-img" src={d.icon}/>
        </if>
        <else-if test={hasText(d.glyph)}>
          <icon class="thumb-glyph" name={d.glyph}/>
        </else-if>
      </box>
      <text class="drop-name">{d.name}</text>
      <if test={hasText(d.qty)}>
        <text class="drop-qty">{d.qty}</text>
      </if>
      <text class="drop-chance">{d.chance}</text>
    </box>
  </for>
</component>

<component name="more" props="sec">
  <if test={interactive() && (hasText(sec.more) || sec.open)}>
    <button class="more-btn" label={sec.open ? t("less") : sec.more} on:activate={toggle(sec.id)}>
      <text class="more">{sec.open ? t("less") : sec.more}</text>
    </button>
  </if>
  <else-if test={hasText(sec.more)}>
    <text class="more">{sec.more}</text>
  </else-if>
</component>

<!-- The tables, one under the other: a title, or the equipped relic's
     block; the rows; "+ n more"; a note of their own. -->
<component name="sections" props="list">
  <for each={list} as="sec" key={sec.id}>
    <box class={sec.cls}>
      <if test={sec.relic}>
        <box class="relic-head">
          <box class="relic-tile">
            <if test={hasText(sec.img)}>
              <image class="relic-img" src={sec.img}/>
            </if>
            <else-if test={hasText(sec.glyph)}>
              <icon class="relic-glyph" name={sec.glyph}/>
            </else-if>
          </box>
          <box class="relic-text">
            <text class="relic-label">{sec.title}</text>
            <box class="relic-line">
              <text class="relic-name">{sec.name}</text>
              <text class={sec.badgeCls}>{sec.badge}</text>
            </box>
          </box>
        </box>
      </if>
      <else>
        <box class="section-head">
          <text class="section-title">{sec.title}</text>
          <if test={hasText(sec.got)}>
            <box class="grow"/>
            <icon class="got-icon" name="check"/>
            <text class="got-text">{sec.got}</text>
          </if>
        </box>
      </else>
      <box class="list">
        <drops items={sec.rows}/>
        <for each={sec.fill} as="f" key={f}>
          <box class="drop filler"><box class="thumb"/><text class="drop-name">&#160;</text></box>
        </for>
        <more sec={sec}/>
        <if test={sec.fillMore}>
          <text class="more">&#160;</text>
        </if>
        <if test={hasText(sec.note)}>
          <text class="more">{sec.note}</text>
        </if>
      </box>
    </box>
  </for>
</component>

<!-- Wide: the rotations side by side, then the other tables. -->
<component name="tables" props="s">
  <box class="tables">
    <if test={s.cols.length > 0}>
      <box class="cols">
        <for each={s.cols} as="col" key={col.id}>
          <box class={colCls(col)}>
            <box class="col-head">
              <text class="col-title">{col.title}</text>
              <if test={col.earned}>
                <icon class="col-check" name="check"/>
                <text class="col-got">{col.got}</text>
              </if>
            </box>
            <drops items={col.rows}/>
            <more sec={col}/>
          </box>
        </for>
      </box>
    </if>
    <sections list={s.sections}/>
  </box>
</component>

<box class={rootClass()}>
  <if test={layout() == "line"}>
    <box class={hasText(state.s.lineAfter) ? "line after" : "line"} label={lineLabel(state.s, state.now)}>
      <icon class={"line-icon tone-" + state.s.lineTone} name={state.s.lineIcon}/>
      <if test={hasText(state.s.line)}>
        <text class="line-main">{at(state.s.line, state.s, state.now)}</text>
      </if>
      <if test={hasText(state.s.lineValue)}>
        <text class="line-big">{at(state.s.lineValue, state.s, state.now)}</text>
      </if>
      <if test={hasText(state.s.lineAfter)}>
        <text class="line-main tone-warning">{state.s.lineAfter}</text>
      </if>
    </box>
  </if>
  <else>
    <box class="head">
      <box class="eyebrow-row">
        <icon class={"eyebrow-icon tone-" + state.s.tone} name={state.s.eyebrowIcon}/>
        <text class={"eyebrow tone-" + state.s.tone}>{eyebrowText(state.s, state.now)}</text>
        <box class="grow"/>
        <if test={hasClock(state.s)}>
          <icon class="clock-icon" name={state.s.clockIcon}/>
          <text class="clock">{clockValue(state.s, state.now)}</text>
        </if>
      </box>
      <if test={hasText(state.s.node)}>
        <text class="place"><span>{state.s.node}</span><span class="planet">{hasText(state.s.planet) ? "  " + state.s.planet : ""}</span></text>
        <if test={hasText(state.s.faction) || state.s.pills.length > 0}>
          <box class="meta">
            <if test={hasText(state.s.faction)}>
              <box class="faction">
                <box class={state.s.factionCls}/>
                <text class="meta-text">{state.s.faction}</text>
              </box>
            </if>
            <for each={state.s.pills} as="p" key={p.id}>
              <box class="pill">
                <icon class="pill-icon" name={p.icon}/>
                <text class="pill-text">{p.text}</text>
              </box>
            </for>
          </box>
        </if>
      </if>
    </box>

    <if test={state.s.heroInline}>
      <box class="next-inline">
        <box class="next-row">
          <text class="next-line"><span class="next-label">{state.s.heroLabel}</span><span class={state.s.heroCls}>{state.s.heroValue}</span></text>
        </box>
        <text class="next-sub">{heroSubText(state.s, state.now)}</text>
      </box>
    </if>
    <else-if test={hasText(state.s.heroValue) || hasText(state.s.heroIcon)}>
      <box class="next">
        <box class="next-text">
          <text class="next-label">{state.s.heroLabel}</text>
          <text class="next-sub">{heroSubText(state.s, state.now)}</text>
        </box>
        <if test={hasText(state.s.heroIcon)}>
          <icon class="next-icon" name={state.s.heroIcon}/>
        </if>
        <else>
          <text class={state.s.heroCls}>{at(state.s.heroValue, state.s, state.now)}</text>
        </else>
      </box>
    </else-if>
    <if test={hasText(state.s.info)}>
      <text class="info">{state.s.info}</text>
    </if>

    <if test={state.s.track.length > 0}>
      <box class="track">
        <if test={hasText(state.s.trackLabel)}>
          <text class="track-label">{state.s.trackLabel}</text>
        </if>
        <for each={state.s.track} as="c" key={c.id}>
          <box class={c.cls}>
            <if test={hasText(c.icon)}>
              <icon class="cell-check" name={c.icon}/>
            </if>
            <text class="cell-text">{c.label}</text>
          </box>
        </for>
      </box>
    </if>

    <if test={hasText(state.s.factsGot)}>
      <box class="facts-box">
      <if test={hasText(state.s.factsTop)}>
        <text class="facts">{state.s.factsTop}</text>
      </if>
      <if test={hasText(state.s.factsGot)}>
        <text class="facts"><span>{state.s.factsLead}</span><span class={state.s.factsCls}>{state.s.factsGot}</span><span>{state.s.factsTail}</span></text>
      </if>
      </box>
    </if>

    <if test={state.s.recap.length > 0}>
      <box class="recap">
        <for each={state.s.recap} as="r" key={r.id}>
          <box class="recap-row">
            <if test={hasText(r.img)}>
              <image class="recap-img" src={r.img}/>
            </if>
            <else>
              <box class="recap-ico"><icon class="recap-icon" name={r.icon}/></box>
            </else>
            <text class="recap-text"><span class="recap-label">{r.label}</span><span class={r.cls}>{r.text}</span></text>
          </box>
        </for>
      </box>
    </if>

    <if test={state.s.empty != null}>
      <box class="empty">
        <icon class={"empty-icon tone-" + state.s.empty.tone + " " + state.s.empty.iconCls} name={state.s.empty.icon}/>
        <text class={"empty-title " + state.s.empty.titleCls}>{state.s.empty.title}</text>
        <if test={hasText(state.s.empty.text)}>
          <text class="empty-text">{state.s.empty.text}</text>
        </if>
      </box>
    </if>

    <!-- Interactive: every row, in a scroll the host gives a bar. Passive:
         the rows the height holds. The panel fills the user's frame. -->
    <if test={state.s.scroll && interactive()}>
      <scroll class="tables-scroll">
        <tables s={state.s}/>
      </scroll>
    </if>
    <else-if test={state.s.scroll}>
      <tables s={state.s}/>
    </else-if>
    <box class="grow-v"/>

    <if test={hasText(state.s.status)}>
      <box class="status-line">
        <icon class="status-icon tone-warning" name="circle-alert"/>
        <text class="status-text tone-warning">{state.s.status}</text>
      </box>
    </if>

    <if test={state.s.source}>
      <text class="source">{t("source")}</text>
    </if>
  </else>
</box>
