<component name="achicon" props="a cls">
  <if test={achSrc(a, state.images) != ""}><image class={cls} src={achSrc(a, state.images)} label={achName(a)}/></if>
  <else><box class={fallbackClass(cls)}><icon name={concealed(a) ? "lock" : a.achieved ? "trophy" : "award"}/></box></else>
</component>

<component name="feature" props="a title metaText cls">
  <box class={cls}>
    <achicon a={a} cls="ach-icon"/>
    <box class="feature-text">
      <box class="feature-top">
        <if test={cls == "feature tracked" || cls == "feature tracked done"}><icon class="pin" name="pin"/></if>
        <text class="feature-eyebrow">{title}</text>
        <if test={cls == "feature new"}><badge class="new-badge">{t("new")}</badge></if>
      </box>
      <text class="feature-name">{achName(a)}</text>
      <text class="feature-meta">{metaText}</text>
    </box>
    <if test={cls == "feature tracked done"}><icon class="done-icon" name="circle-check"/></if>
  </box>
</component>

<component name="trackedcard" props="items">
  <box class="tracked-card">
    <box class="feature-top"><icon class="pin" name="pin"/><text class="section-title">{t("tracked-many")}</text></box>
    <for each={items} as="a" key={a.id}>
      <box class={a.achieved ? "trow done" : "trow"} tooltip={achDesc(a)}>
        <achicon a={a} cls="row-icon"/>
        <box class="row-text">
          <text class={concealed(a) ? "row-name hidden" : "row-name"}>{achName(a)}</text>
          <text class={a.achieved ? "row-desc ok" : "row-desc"}>{featureMeta(a, state)}</text>
        </box>
        <if test={a.achieved}><icon class="done-icon" name="circle-check"/></if>
      </box>
    </for>
  </box>
</component>

<component name="gameicon" props="cls">
  <if test={iconSrc(state) != ""}><image class={cls} src={iconSrc(state)} label={state.game.name}/></if>
  <else><box class={fallbackClass(cls)}><icon name="gamepad-2"/></box></else>
</component>

<box class={rootClass(state)}>
  <if test={phase(state) == "loading"}>
    <box class="skeleton">
      <box class="sk-head"><box class="sk-icon"/><box class="sk-lines"><box class="sk sk-short"/><box class="sk sk-long"/></box></box>
      <if test={layout(state.optionsVersion) != "line"}><box class="sk sk-bar"/><text class="sk-note">{t("loading")}</text></if>
    </box>
  </if>

  <else-if test={phase(state) == "profile"}>
    <if test={layout(state.optionsVersion) == "line"}>
      <if test={state.interactive}>
        <form class="pform line-form" on:submit={submitProfile}>
          <field class={profileError(state) ? "pfield invalid" : "pfield"} placeholder={t("profile-placeholder-short")} label={t("profile-placeholder")} value={state.profile.value} max-length="256" on:input={profileTyped(event.value)}/>
          <button class="pgo" submit label={t("profile-save")} tooltip={profileMessage(state, true)}><icon name="arrow-right"/></button>
        </form>
      </if>
      <else>
        <box class="line-msg"><icon class="msg-icon" name="user-round"/><text class="line-text">{t("profile-passive-short")}</text></box>
      </else>
    </if>
    <else>
      <box class="profile">
        <if test={layout(state.optionsVersion) == "compact"}><text class="eyebrow accent">{t("step-short")}</text></if>
        <else>
          <text class="eyebrow accent">{t("step")}</text>
          <text class="title">{t("profile-title")}</text>
        </else>
        <if test={state.interactive}>
          <form class="pform" on:submit={submitProfile}>
            <field class={profileError(state) ? "pfield invalid" : "pfield"} placeholder={t("profile-placeholder")} label={t("profile-placeholder")} value={state.profile.value} max-length="256" on:input={profileTyped(event.value)}/>
            <button class="pbutton" submit label={t("profile-save")}><text class="pbutton-text">{t("profile-save")}</text></button>
          </form>
          <box class="pfoot">
            <text class={profileError(state) ? "pmsg error" : "pmsg"}><if test={profileError(state)}><icon class="inline-icon" name="circle-alert"/></if><span>&#32;{profileMessage(state, layout(state.optionsVersion) == "compact")}</span></text>
            <if test={state.profile.canCancel}>
              <button class="ghost" on:activate={cancelProfile}><text class="ghost-text">{t("profile-cancel")}</text></button>
            </if>
          </box>
        </if>
        <else><text class="pmsg">{t("profile-passive")}</text></else>
      </box>
    </else>
  </else-if>

  <else-if test={phase(state) == "hidden"}>
    <if test={layout(state.optionsVersion) == "line"}>
      <box class="empty" tooltip={hiddenTip(state)}>
        <icon class="empty-icon warn" name="eye-off"/>
        <text class="line-text">{hiddenTitle(state)}</text>
      </box>
    </if>
    <else>
      <box class="empty veiled">
        <icon class="empty-icon warn" name="eye-off"/>
        <box class="empty-text">
          <if test={layout(state.optionsVersion) != "compact"}><text class="empty-title">{hiddenTitle(state)}</text></if>
          <text class="empty-body">{hiddenBody(state)}</text>
          <box class="fix-path">
            <icon class="fix-icon" name="settings"/>
            <box class="fix-lines">
              <text class="fix-text">{hiddenPath(state)}</text>
              <text class="fix-value">{hiddenSetting(state)}</text>
            </box>
          </box>
        </box>
      </box>
    </else>
  </else-if>

  <else-if test={phase(state) == "nothing" || phase(state) == "empty-unreachable"}>
    <box class="empty">
      <icon class={phase(state) == "nothing" ? "empty-icon" : "empty-icon warn"} name={phase(state) == "nothing" ? "trophy" : "cloud-off"}/>
      <if test={layout(state.optionsVersion) == "line"}>
        <text class="line-text">{phase(state) == "nothing" ? t("nothing-short") : t("empty-unreachable")}</text>
      </if>
      <else>
        <box class="empty-text">
          <if test={phase(state) == "nothing" && layout(state.optionsVersion) != "compact"}><text class="empty-title">{t("nothing-title")}</text></if>
          <text class="empty-body">{phase(state) == "nothing" ? t("nothing") : t("empty-unreachable")}</text>
        </box>
      </else>
    </box>
  </else-if>

  <else-if test={state.picking && state.interactive}>
    <box class="picker">
      <box class="picker-top">
        <text class="eyebrow accent">{t("pick-title")}</text>
        <text class={pickFull(state) ? "counter max" : "counter"}>{pickCount(state)}</text>
      </box>
      <if test={pickFull(state)}><text class="pmsg warn"><icon class="inline-icon" name="circle-alert"/><span>&#32;{t("pick-full")}</span></text></if>
      <else><text class="pmsg">{t("pick-hint")}</text></else>
      <scroll class="pick-list">
        <for each={pickList(state)} as="a" key={a.id}>
          <button class={pickRowClass(a, state)} label={pickLabel(a, state)} disabled={pickDisabled(a, state)} on:activate={toggleTrack(a.id)}>
            <achicon a={a} cls="row-icon"/>
            <box class="row-text">
              <text class={concealed(a) ? "row-name hidden" : "row-name"}>{achName(a)}</text>
              <text class="row-desc">{achDesc(a)}</text>
            </box>
            <if test={a.achieved}><icon class="row-ok" name="circle-check"/></if>
            <else-if test={showRarity(state.optionsVersion) && rarityShort(a) != ""}><text class="row-side">{rarityShort(a)}</text></else-if>
            <if test={isTracked(a, state)}><box class="check on"><icon name="check"/></box></if>
            <else><box class="check"/></else>
          </button>
        </for>
      </scroll>
      <box class="pick-actions">
        <button class="pbutton" on:activate={closePick}><text class="pbutton-text">{t("done")}</text></button>
      </box>
    </box>
  </else-if>

  <else-if test={state.game}>
    <if test={layout(state.optionsVersion) == "line"}>
      <box class="line">
        <box class="line-top">
          <gameicon cls="line-icon"/>
          <text class="line-name">{state.game.name}</text>
          <if test={isStale(state)}><icon class="warn-icon" name={staleIcon(state)} tooltip={eyebrow(state)}/></if>
          <else-if test={state.game.known && !state.game.readable}><icon class="warn-icon" name="circle-alert" tooltip={muted(state.game)}/></else-if>
          <if test={hasAch(state.game)}>
            <if test={missingOnly(state.optionsVersion)}><text class="line-count">{countText(state.game, state.optionsVersion)}</text></if>
            <else><text class={anyNew(state) ? "line-count new" : "line-count"}><span class="num">{num(state.game.unlocked)}</span><span class="of">&#32;/&#32;{num(state.game.total)}</span></text></else>
          </if>
        </box>
        <if test={hasAch(state.game)}>
          <progress class={done(state.game) ? "line-bar done" : "line-bar"} value={state.game.unlocked} max={state.game.total} label={pct(state.game)}/>
        </if>
      </box>
    </if>
    <else>
      <box class={hasHeader(state) ? "gamecard" : "gamecard bare"}>
        <if test={layout(state.optionsVersion) == "full" && hasHeader(state)}>
          <box class="banner-clip"><image class="banner" src={gameSrc(state)} label={state.game.name}/></box>
        </if>
        <box class="head">
          <if test={layout(state.optionsVersion) != "full" || !hasHeader(state)}>
            <if test={hasHeader(state)}><image class="capsule" src={gameSrc(state)} label={state.game.name}/></if>
            <else><gameicon cls="capsule-icon"/></else>
          </if>
          <box class="head-text">
            <box class="eyebrow-row" tooltip={staleTip(state)}>
              <if test={isStale(state)}><icon class="eyebrow-icon" name={staleIcon(state)}/></if>
              <else-if test={state.game.playing}><box class="live-dot"/></else-if>
              <text class={eyebrowClass(state)}>{eyebrow(state)}</text>
            </box>
            <if test={layout(state.optionsVersion) != "full" || !hasHeader(state)}><text class="game-name">{state.game.name}</text></if>
          </box>
          <if test={steamLogo(state.theme, state.optionsVersion) != ""}>
            <image class="steam-mark" src={steamLogo(state.theme, state.optionsVersion)} label="Steam" tooltip={t("source")}/>
          </if>
          <else><text class="source-word" tooltip={t("source")}>Steam</text></else>
        </box>
        <if test={hasAch(state.game)}>
          <box class="prog">
            <progress class={done(state.game) ? "bar done" : "bar"} value={state.game.unlocked} max={state.game.total} label={pct(state.game)}/>
            <if test={missingOnly(state.optionsVersion) && !done(state.game)}>
              <text class="count">{countText(state.game, state.optionsVersion)}</text>
            </if>
            <else>
              <text class="count"><span class="num">{num(state.game.unlocked)}</span><span class="of">&#32;/&#32;{num(state.game.total)}</span></text>
            </else>
            <if test={done(state.game)}><icon class="done-icon" name="circle-check" label={t("all-done")}/></if>
            <else><text class="pct">{pct(state.game)}</text></else>
          </box>
        </if>
        <else><text class="muted-line">{muted(state.game)}</text></else>
        <if test={showFix(state.game, state.optionsVersion)}>
          <box class="fix-path">
            <icon class="fix-icon" name="settings"/>
            <box class="fix-lines">
              <text class="fix-text">{t("hidden-path")}</text>
              <text class="fix-value">{t("hidden-details-setting")}</text>
            </box>
          </box>
        </if>
      </box>

      <if test={layout(state.optionsVersion) == "standard" && hasAch(state.game) && trackedMany(state)}>
        <trackedcard items={trackedList(state)}/>
      </if>
      <if test={layout(state.optionsVersion) == "standard" && hasAch(state.game) && featured(state, state.optionsVersion)}>
        <feature a={featured(state, state.optionsVersion)} title={featuredTitle(state, state.optionsVersion)} metaText={featureMeta(featured(state, state.optionsVersion), state)} cls={cardClass(featured(state, state.optionsVersion), state)}/>
      </if>

      <if test={layout(state.optionsVersion) == "full" && hasAch(state.game)}>
        <if test={tracked(state)}>
          <feature a={tracked(state)} title={t("tracked")} metaText={featureMeta(tracked(state), state)} cls={cardClass(tracked(state), state)}/>
        </if>
        <if test={trackedMany(state)}><trackedcard items={trackedList(state)}/></if>
        <if test={!missingOnly(state.optionsVersion) && !hasTracked(state) && latest(state)}>
          <feature a={latest(state)} title={t("latest")} metaText={meta(latest(state), state)} cls={cardClass(latest(state), state)}/>
        </if>
        <box class="lists">
          <if test={!missingOnly(state.optionsVersion) && recent(state, rows(state.optionsVersion)).length > 0}>
            <box class="section">
              <text class="section-title">{t("recent")}</text>
              <for each={recent(state, rows(state.optionsVersion))} as="a" key={a.id}>
                <box class="row">
                  <achicon a={a} cls="row-icon"/>
                  <text class="row-name">{achName(a)}</text>
                  <text class="row-side">{a.at > 0 ? ago(state.now - a.at) : ""}</text>
                </box>
              </for>
            </box>
          </if>
          <box class="section">
            <text class="section-title">{missingOnly(state.optionsVersion) ? t("missing") : t("next")}</text>
            <if test={done(state.game)}>
              <text class="all-done"><icon class="inline-icon" name="circle-check"/><span>&#32;{t("all-done")}</span></text>
            </if>
            <for each={missing(state, missingOnly(state.optionsVersion) ? rows(state.optionsVersion) * 2 : rows(state.optionsVersion), state.optionsVersion)} as="a" key={a.id}>
              <box class="row" tooltip={achDesc(a)}>
                <achicon a={a} cls="row-icon"/>
                <box class="row-text">
                  <text class={concealed(a) ? "row-name hidden" : "row-name"}>{achName(a)}</text>
                  <text class="row-desc">{achDesc(a)}</text>
                </box>
                <if test={showRarity(state.optionsVersion) && rarityShort(a) != ""}><text class="row-side" tooltip={rarity(a)}>{rarityShort(a)}</text></if>
              </box>
            </for>
          </box>
        </box>
      </if>
    </else>
  </else-if>
</box>
