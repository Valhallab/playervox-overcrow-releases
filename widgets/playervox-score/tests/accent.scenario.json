{
  "scenarioVersion": 1,
  "name": "accent",
  "description": "The user's accent, dark theme, changed while the widget runs: nothing reloads. Portal 2 graded S+: the faint glow around the badge takes the accent, drawn again at the change; the badge itself keeps the grade's colour. Lime first, then red, steel and blue.",
  "host": {
    "theme": "dark",
    "scale": 1000,
    "userAccent": "lime"
  },
  "fixtures": {
    "subscriptions": {
      "playervox.score.subscribe": {
        "state": "loading",
        "name": null,
        "score": null,
        "grade": "--",
        "ratingsCount": 0,
        "criteria": {
          "gameplay": null,
          "art": null,
          "tech": null
        }
      }
    }
  },
  "steps": [
    {
      "expect": {
        "text": [
          "Community rating",
          "Loading…"
        ],
        "state": "running",
        "calls": [
          {
            "service": "playervox.score.subscribe",
            "outcome": "ok"
          }
        ]
      }
    },
    {
      "publish": {
        "service": "playervox.score.subscribe",
        "value": {
          "state": "ready",
          "name": "Portal 2",
          "score": 94.2,
          "grade": "S+",
          "ratingsCount": 1284,
          "criteria": {
            "gameplay": 97.4,
            "art": 90.1,
            "tech": 94.6
          }
        }
      }
    },
    {
      "expect": {
        "text": [
          "Portal 2",
          "1,284 ratings"
        ]
      }
    },
    {
      "expect": {
        "state": "running",
        "fault": "none",
        "image": "s-plus-lime"
      }
    },
    {
      "host": {
        "userAccent": "red"
      }
    },
    {
      "expect": {
        "state": "running",
        "fault": "none",
        "image": "s-plus-red"
      }
    },
    {
      "host": {
        "userAccent": "steel"
      }
    },
    {
      "expect": {
        "state": "running",
        "fault": "none",
        "image": "s-plus-steel"
      }
    },
    {
      "host": {
        "userAccent": "blue"
      }
    },
    {
      "expect": {
        "state": "running",
        "fault": "none",
        "image": "s-plus-blue"
      }
    }
  ]
}
