{
  "scenarioVersion": 1,
  "name": "options",
  "description": "The four menu toggles: the badge alone (the host background at 0 % replaces the egui frameless look) in each theme and at 150 %, badge and title, the score without votes, the votes without score (centred on the badge), a status with and without its hint, a long title cut with an ellipsis, a large count, a single rating, no title with the mark kept, and the criteria.",
  "host": {
    "options": {
      "show-score": false,
      "show-criteria": false,
      "show-title": false,
      "show-votes": false
    }
  },
  "fixtures": {
    "subscriptions": {
      "playervox.score.subscribe": {
        "state": "ready",
        "name": "Portal 2",
        "score": 94.2,
        "grade": "S+",
        "ratingsCount": 1284,
        "criteria": {
          "gameplay": 97.4,
          "art": 90.1,
          "tech": 94.6
        }
      }
    }
  },
  "steps": [
    {
      "expect": {
        "state": "running",
        "noText": [
          "Portal 2",
          "94",
          "1,284 ratings"
        ],
        "image": "badge-only-ready"
      }
    },
    {
      "publish": {
        "service": "playervox.score.subscribe",
        "value": {
          "state": "loading",
          "name": null,
          "score": null,
          "grade": "--",
          "ratingsCount": 0,
          "criteria": {
            "gameplay": null,
            "art": null,
            "tech": null
          }
        }
      }
    },
    {
      "expect": {
        "image": "badge-only-loading"
      }
    },
    {
      "host": {
        "theme": "light"
      }
    },
    {
      "publish": {
        "service": "playervox.score.subscribe",
        "value": {
          "state": "ready",
          "name": "Portal 2",
          "score": 94.2,
          "grade": "S+",
          "ratingsCount": 1284,
          "criteria": {
            "gameplay": 97.4,
            "art": 90.1,
            "tech": 94.6
          }
        }
      }
    },
    {
      "expect": {
        "image": "badge-only-light"
      }
    },
    {
      "host": {
        "theme": "dark",
        "scale": 1500
      }
    },
    {
      "expect": {
        "image": "badge-only-150"
      }
    },
    {
      "host": {
        "scale": 1000
      }
    },
    {
      "menu": {
        "id": "show-title",
        "value": true
      }
    },
    {
      "expect": {
        "text": [
          "Portal 2"
        ],
        "image": "badge-and-title"
      }
    },
    {
      "menu": {
        "id": "show-score",
        "value": true
      }
    },
    {
      "expect": {
        "noText": [
          "1,284 ratings"
        ],
        "image": "score-without-votes"
      }
    },
    {
      "menu": {
        "id": "show-score",
        "value": false
      }
    },
    {
      "menu": {
        "id": "show-votes",
        "value": true
      }
    },
    {
      "expect": {
        "text": [
          "1,284 ratings"
        ],
        "noText": [
          "94"
        ],
        "image": "votes-without-score"
      }
    },
    {
      "publish": {
        "service": "playervox.score.subscribe",
        "value": {
          "state": "not_found",
          "name": null,
          "score": null,
          "grade": "--",
          "ratingsCount": 0,
          "criteria": {
            "gameplay": null,
            "art": null,
            "tech": null
          }
        }
      }
    },
    {
      "expect": {
        "text": [
          "Game not found",
          "On PlayerVox"
        ],
        "image": "hint-without-score"
      }
    },
    {
      "menu": {
        "id": "show-votes",
        "value": false
      }
    },
    {
      "menu": {
        "id": "show-score",
        "value": true
      }
    },
    {
      "expect": {
        "text": [
          "Game not found"
        ],
        "noText": [
          "On PlayerVox"
        ],
        "image": "status-without-hint"
      }
    },
    {
      "menu": {
        "id": "show-votes",
        "value": true
      }
    },
    {
      "publish": {
        "service": "playervox.score.subscribe",
        "value": {
          "state": "ready",
          "name": "The Elder Scrolls V: Skyrim Special Edition — Anniversary Upgrade Pack",
          "score": 94.2,
          "grade": "S+",
          "ratingsCount": 123456789,
          "criteria": {
            "gameplay": 97.4,
            "art": 90.1,
            "tech": 94.6
          }
        }
      }
    },
    {
      "expect": {
        "text": [
          "123,456,789 ratings"
        ],
        "image": "long-title-large-count"
      }
    },
    {
      "publish": {
        "service": "playervox.score.subscribe",
        "value": {
          "state": "ready",
          "name": "Portal 2",
          "score": 94.2,
          "grade": "S+",
          "ratingsCount": 1,
          "criteria": {
            "gameplay": 97.4,
            "art": 90.1,
            "tech": 94.6
          }
        }
      }
    },
    {
      "expect": {
        "text": [
          "1 rating"
        ],
        "image": "one-rating"
      }
    },
    {
      "menu": {
        "id": "show-title",
        "value": false
      }
    },
    {
      "expect": {
        "image": "without-title"
      }
    },
    {
      "menu": {
        "id": "show-criteria",
        "value": true
      }
    },
    {
      "publish": {
        "service": "playervox.score.subscribe",
        "value": {
          "state": "ready",
          "name": "Portal 2",
          "score": 94.2,
          "grade": "S+",
          "ratingsCount": 1284,
          "criteria": {
            "gameplay": 97.4,
            "art": 90.1,
            "tech": 94.6
          }
        }
      }
    },
    {
      "expect": {
        "image": "criteria-without-title"
      }
    }
  ]
}
