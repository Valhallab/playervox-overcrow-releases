{
  "scenarioVersion": 1,
  "name": "preview",
  "description": "Portal 2 rated S+ by the community, with its default display. The marketplace preview: dark theme, English, 150 %, on the stage colour; scripts/compose-previews.mjs frames it into assets/preview.png.",
  "host": {
    "scale": 1500,
    "background": "#1e242e"
  },
  "fixtures": {
    "subscriptions": {
      "playervox.score.subscribe": {
        "state": "loading",
        "name": null,
        "score": null,
        "grade": "--",
        "ratingsCount": 0,
        "criteria": {
          "gameplay": null,
          "art": null,
          "tech": null
        }
      }
    }
  },
  "steps": [
    {
      "expect": {
        "text": [
          "Community rating",
          "Loading…"
        ],
        "state": "running",
        "calls": [
          {
            "service": "playervox.score.subscribe",
            "outcome": "ok"
          }
        ]
      }
    },
    {
      "publish": {
        "service": "playervox.score.subscribe",
        "value": {
          "state": "ready",
          "name": "Portal 2",
          "score": 94.2,
          "grade": "S+",
          "ratingsCount": 1284,
          "criteria": {
            "gameplay": 97.4,
            "art": 90.1,
            "tech": 94.6
          }
        }
      }
    },
    {
      "expect": {
        "text": [
          "Portal 2",
          "1,284 ratings"
        ],
        "image": "preview"
      }
    }
  ]
}
