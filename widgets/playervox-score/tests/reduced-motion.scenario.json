{
  "scenarioVersion": 1,
  "name": "reduced-motion",
  "description": "With the user's reduced-motion preference the badge does not pulse when a score shows or changes: 240 ms in, where the pulse would be at its peak, the badge is at its settled size.",
  "host": {
    "reducedMotion": true
  },
  "fixtures": {
    "subscriptions": {
      "playervox.score.subscribe": {
        "state": "loading",
        "name": null,
        "score": null,
        "grade": "--",
        "ratingsCount": 0,
        "criteria": {
          "gameplay": null,
          "art": null,
          "tech": null
        }
      }
    }
  },
  "steps": [
    {
      "expect": {
        "state": "running"
      }
    },
    {
      "publish": {
        "service": "playervox.score.subscribe",
        "value": {
          "state": "ready",
          "name": "Portal 2",
          "score": 94.2,
          "grade": "S+",
          "ratingsCount": 1284,
          "criteria": {
            "gameplay": 97.4,
            "art": 90.1,
            "tech": 94.6
          }
        }
      }
    },
    {
      "advance": {
        "ms": 240
      }
    },
    {
      "expect": {
        "image": "score-no-pulse"
      }
    },
    {
      "publish": {
        "service": "playervox.score.subscribe",
        "value": {
          "state": "ready",
          "name": "Portal 2",
          "score": 84,
          "grade": "S",
          "ratingsCount": 1284,
          "criteria": {
            "gameplay": 97.4,
            "art": 90.1,
            "tech": 94.6
          }
        }
      }
    },
    {
      "advance": {
        "ms": 240
      }
    },
    {
      "expect": {
        "image": "new-score-no-pulse",
        "fault": "none"
      }
    }
  ]
}
