  "host": {
    "storage": {
      "state": {
        "query": "arcane"
      }
    },
    "scale": 1500,
    "background": "#1e242e",
    "mode": "interactive",
    "size": {
      "width": 360,
      "height": 340
    }
  },
  "fixtures": {
