            },
            "outcome": "ok"
          },
          {
            "service": "storage.set",
            "outcome": "ok"
          },
          {
            "service": "storage.remove",
            "params": {
              "key": "catalog-1"
            },
            "outcome": "ok"
          },
          {
            "service": "storage.remove",
            "params": {
              "key": "catalog-2"
            },
            "outcome": "ok"
          },
          {
            "service": "storage.set",
            "params": {
              "key": "catalog",
              "value": {
                "version": "v1",
                "chunks": 1
