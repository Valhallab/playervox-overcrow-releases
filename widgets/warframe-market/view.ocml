<!-- Warframe Market: search the PC item catalog, compare the online offers
     of one item, sellers and buyers in two tabs, and copy a trade whisper
     (the Web widget it replaces: widgets/warframe-market before P4.3). -->
<component name="offers" props="side orders feedback">
  <if test={orders.length == 0}>
    <text class="no-offers">{noOffers(side)}</text>
  </if>
  <else>
    <for each={orders} as="order" key={order.id}>
      <box class="order">
        <box class="order-line">
          <text class="order-price">{price(order.platinum)}</text>
          <box class="order-player">
            <text class="order-trader" tooltip={order.trader}>{order.trader}</text>
            <box class={presenceClass(order.presence)} label={presenceLabel(order.presence)} tooltip={presenceLabel(order.presence)}/>
          </box>
          <button class={copyClass(feedback, side, order.id)} label={t("copy-to", { name: order.trader })} disabled={copyBusy(feedback)} on:activate={copy(side, order.id)}>
            <if test={copyClass(feedback, side, order.id) == "copy copied"}>
              <icon class="copy-icon" name="check"/>
            </if>
            <text class="copy-text">{copyLabel(feedback, side, order.id)}</text>
          </button>
        </box>
        <text class="order-detail">{orderDetail(order)}</text>
      </box>
    </for>
  </else>
</component>

<box class="market">
  <box class="identity">
    <box class="identity-text">
      <text class="eyebrow brand">{t("eyebrow")}</text>
      <text class="subtitle">{t("subtitle")}</text>
    </box>
    <badge class="platform">{t("platform")}</badge>
  </box>
  <box class="search">
    <text class="search-label">{t("search-label")}</text>
    <box class="search-controls">
      <field class="query" label={t("search-field")} value={state.query} placeholder={t("placeholder")} max-length="256" on:input={search}/>
      <button class="clear" label={t("clear")} disabled={state.query == ""} on:activate={clear}>
        <text class="clear-text">{t("clear")}</text>
      </button>
    </box>
    <text class="hint">{searchHint(state.interactive)}</text>
  </box>
  <text class={statusClass(state.error)}>{liveStatus(state.phase, state.count, state.error, state.detail, state.loadingOrders, state.refreshing)}</text>
  <if test={state.detail}>
    <scroll class="detail">
      <box class="item-heading">
        <box class="item-title">
          <text class="eyebrow">{t("selected")}</text>
          <text class="item-name">{state.detail.name}</text>
        </box>
        <button class="refresh" label={t("refresh")} tooltip={t("refresh")} disabled={refreshBusy(state.loadingOrders, state.refreshing)} on:activate={refresh}>
          <icon name="refresh-cw"/>
        </button>
        <button class="back" label={t("back")} tooltip={t("back")} on:activate={back}>
          <icon name="arrow-left"/>
        </button>
      </box>
      <box class="metrics">
        <box class="metric">
          <text class="metric-label">{t("min-sell")}</text>
          <text class="metric-value brand">{unitPrice(state.detail.sells, true)}</text>
        </box>
        <box class="metric">
          <text class="metric-label">{t("max-buy")}</text>
          <text class="metric-value">{unitPrice(state.detail.buys, false)}</text>
        </box>
      </box>
      <box class="tabs">
        <button class={tabClass(state.tab, "sell")} label={t("sellers")} on:activate={showTab("sell")}>
          <text class="tab-text">{t("sellers")}</text>
          <text class="tab-count">{tabCount(state.detail, "sell")}</text>
        </button>
        <button class={tabClass(state.tab, "buy")} label={t("buyers")} on:activate={showTab("buy")}>
          <text class="tab-text">{t("buyers")}</text>
          <text class="tab-count">{tabCount(state.detail, "buy")}</text>
        </button>
      </box>
      <offers side={state.tab} orders={tabOrders(state.detail, state.tab)} feedback={state.copy}/>
      <if test={moreOffers(state.detail, state.tab) != ""}>
        <text class="more">{moreOffers(state.detail, state.tab)}</text>
      </if>
    </scroll>
  </if>
  <else-if test={state.results.length > 0}>
    <list class="results" item-height="32">
      <for each={state.results} as="item" key={item.slug}>
        <button class="result" label={item.name} on:activate={select(item.slug)}>
          <text class="result-name">{item.name}</text>
          <icon class="result-arrow" name="chevron-right"/>
        </button>
      </for>
    </list>
  </else-if>
  <else>
    <box class="empty">
      <text class="empty-text">{emptyText(state.query, state.phase)}</text>
    </box>
  </else>
  <if test={state.detail}>
    <box class="legend">
      <box class="legend-item">
        <box class="presence ingame"/>
        <text class="legend-text">{presenceLabel("ingame")}</text>
      </box>
      <box class="legend-item">
        <box class="presence online"/>
        <text class="legend-text">{presenceLabel("online")}</text>
      </box>
    </box>
  </if>
</box>
