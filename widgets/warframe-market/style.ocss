/* One column: identity, search, status, then the results or the selected
   item, and the copy status at the bottom. The wrapper draws the panel. */
.market {
  flex-direction: column;
  flex-grow: 1;
  gap: var(--space-5);
  width: 100%;
  height: 100%;
  padding: 14px;
}

.identity,
.search-controls,
.offer-heading,
.item-heading {
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-4);
}

.identity-text,
.item-title {
  flex-direction: column;
  gap: var(--space-1);
  flex-shrink: 1;
  min-width: 0;
}

.eyebrow {
  font-size: var(--font-size-caption);
  font-weight: 700;
  letter-spacing: 1.2px;
  text-transform: uppercase;
  color: var(--color-text-muted);
}

.brand {
  color: var(--color-accent);
}

.subtitle {
  font-size: 13px;
  font-weight: 600;
}

.platform {
  font-size: var(--font-size-caption);
  color: var(--color-text-muted);
  background: var(--color-surface-raised);
  border: 1px solid var(--color-border);
  border-radius: 5px;
  padding: 3px 7px;
  white-space: nowrap;
}

/* Search. */
.search {
  flex-direction: column;
  gap: 5px;
}

.search-label {
  font-size: var(--font-size-small);
  font-weight: 600;
  color: var(--color-text-muted);
}

.query {
  flex-grow: 1;
  width: auto;
  min-width: 0;
  font-size: 12px;
  background: var(--color-surface-field);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-sm);
  padding: 0 9px;
}

.query:focus {
  border-color: var(--color-accent);
}

.clear,
.result,
.copy,
.back {
  background: var(--color-surface-raised);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-sm);
  cursor: pointer;
}

.clear:hover,
.result:hover,
.copy:hover,
.back:hover {
  background: var(--color-surface-hover);
  border-color: var(--color-border-strong);
}

.clear:focus,
.result:focus,
.copy:focus,
.back:focus {
  border-color: var(--color-accent);
}

.clear:disabled,
.copy:disabled {
  opacity: 0.65;
  cursor: default;
}

.clear {
  height: var(--control-height);
  align-items: center;
  padding: 0 9px;
}

.clear-text,
.copy-text {
  font-size: 12px;
  white-space: nowrap;
}

.clear:disabled .clear-text {
  color: var(--color-text-muted);
}

.hint,
.status {
  font-size: var(--font-size-caption);
  color: var(--color-text-muted);
}

.status {
  min-height: 14px;
}

.error {
  color: var(--color-danger);
}

/* Results. */
.results {
  flex-grow: 1;
  flex-shrink: 1;
  min-height: 0;
  gap: 5px;
}

.result {
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
  padding: 7px 9px;
}

.result-name {
  flex-shrink: 1;
  min-width: 0;
  font-size: 12px;
  overflow-wrap: anywhere;
}

.result-arrow {
  font-size: 16px;
  color: var(--color-accent);
}

.empty {
  flex-grow: 1;
  align-items: center;
  justify-content: center;
  padding: 32px 20px;
  border: 1px solid var(--color-border);
  border-radius: 7px;
}

.empty-text {
  font-size: 12px;
  text-align: center;
  color: var(--color-text-muted);
}

/* The selected item. */
.detail {
  flex-grow: 1;
  flex-shrink: 1;
  min-height: 0;
  flex-direction: column;
  gap: 10px;
}

.back {
  width: var(--control-height);
  height: var(--control-height);
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  font-size: 14px;
}

.item-name {
  font-size: 17px;
  font-weight: 600;
  overflow-wrap: anywhere;
}

.metrics {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 7px;
}

.metric {
  flex-direction: column;
  gap: var(--space-1);
  padding: 8px 10px;
  background: var(--color-surface-raised);
  border: 1px solid var(--color-border);
  border-radius: 7px;
  min-width: 0;
}

.metric-label {
  font-size: var(--font-size-caption);
  color: var(--color-text-muted);
}

.metric-value {
  font-size: 18px;
  font-weight: 600;
  font-variant-numeric: tabular-nums;
  white-space: nowrap;
}

.variant-hint {
  font-size: var(--font-size-small);
  color: var(--color-text-muted);
}

.offers {
  flex-direction: column;
  margin-top: var(--space-2);
}

.offer-heading {
  margin-bottom: 5px;
}

.offer-title {
  font-size: 12px;
  font-weight: 600;
}

.offer-count,
.no-offers {
  font-size: var(--font-size-caption);
  color: var(--color-text-muted);
}

.no-offers {
  padding: 12px 8px;
  border-top: 1px solid var(--color-border);
}

.order {
  flex-direction: column;
  gap: var(--space-2);
  padding: 7px 8px;
  border-top: 1px solid var(--color-border);
}

.order:hover {
  background: var(--color-surface-raised);
}

.order-line {
  display: grid;
  grid-template-columns: 57px minmax(0, 1fr) 69px 99px;
  align-items: center;
  column-gap: 8px;
}

.order-price {
  font-size: 12px;
  font-weight: 600;
  font-variant-numeric: tabular-nums;
  color: var(--color-accent);
  white-space: nowrap;
}

.order-trader {
  font-size: 12px;
  white-space: nowrap;
  text-overflow: ellipsis;
  overflow: hidden;
}

.presence {
  font-size: var(--font-size-caption);
  white-space: nowrap;
  color: var(--color-text-muted);
}

.ingame {
  color: var(--color-accent);
}

.online {
  color: var(--color-text-secondary);
}

.copy {
  flex-direction: row;
  align-items: center;
  justify-content: center;
  gap: var(--space-2);
  padding: 5px 6px;
}

.copy-icon {
  font-size: 11px;
  color: var(--color-accent);
}

.copy .copy-text {
  font-size: var(--font-size-caption);
}

.copied {
  border-color: var(--color-accent);
}

.copied .copy-text {
  color: var(--color-accent);
}

.failed .copy-text {
  color: var(--color-danger);
}

.order-detail {
  font-size: var(--font-size-small);
  color: var(--color-text-muted);
  overflow-wrap: anywhere;
}

/* Copy status, always at the bottom. */
.copy-status {
  flex-shrink: 0;
  min-height: 28px;
  padding-top: 9px;
  border-top: 1px solid var(--color-border);
  font-size: var(--font-size-caption);
  color: var(--color-text-muted);
}

.copy-status.copied {
  border-color: var(--color-border);
  color: var(--color-accent);
}

.copy-status.failed {
  color: var(--color-danger);
}
