{
  "scenarioVersion": 1,
  "name": "states",
  "description": "Passive mode: Loading until the host's first document, then the active note: its title, text and checklist, the checked entries last. Dark English and light French, at 100 % and 150 %. The Show row: the note alone, the checklist alone. Checked entries in their stored place. A note without text, without checklist, without either; no note at all; a checklist longer than the panel.",
  "steps": [
    {
      "expect": {
        "text": [
          "Loading notes…"
        ],
        "image": "loading-dark-en",
        "calls": [
          {
            "service": "notes.subscribe"
          }
        ]
      }
    },
    {
      "publish": {
        "service": "notes.subscribe",
        "value": {
          "active": "note-1",
          "notes": [
            {
              "id": "note-1",
              "title": "Expedition",
              "body": "Find the northern entrance before sunset.\nBring rope.",
              "items": [
                {
                  "id": "local-1",
                  "text": "Pack torches",
                  "checked": true
                },
                {
                  "id": "local-2",
                  "text": "Sharpen the blade",
                  "checked": false
                },
                {
                  "id": "local-3",
                  "text": "Buy healing potions for the whole party before leaving town",
                  "checked": false
                }
              ]
            },
            {
              "id": "note-2",
              "title": "Build ideas",
              "body": "Fire sword first, then armor.",
              "items": []
            },
            {
              "id": "note-3",
              "title": "A very long note title that must be cut in the selector and in the list",
              "body": "",
              "items": [
                {
                  "id": "local-4",
                  "text": "One entry",
                  "checked": false
                }
              ]
            },
            {
              "id": "note-4",
              "title": "Route",
              "body": "North gate, then the river.",
              "items": [
                {
                  "id": "local-5",
                  "text": "Buy a map",
                  "checked": true
                }
              ]
            }
          ]
        }
      }
    },
