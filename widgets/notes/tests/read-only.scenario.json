{
  "scenarioVersion": 1,
  "name": "read-only",
  "description": "With the permission to read alone the widget shows the active note in both modes and nothing that writes: no selector, no check, no editor.",
  "host": {
    "mode": "interactive",
    "grants": [
      "notes.read"
    ]
  },
  "fixtures": {
    "subscriptions": {
      "notes.subscribe": {
        "active": "note-1",
        "notes": [
          {
            "id": "note-1",
            "title": "Expedition",
            "body": "Find the northern entrance before sunset.\nBring rope.",
            "items": [
              {
                "id": "local-1",
                "text": "Pack torches",
                "checked": true
              },
              {
                "id": "local-2",
                "text": "Sharpen the blade",
                "checked": false
              },
              {
                "id": "local-3",
                "text": "Buy healing potions for the whole party before leaving town",
                "checked": false
              }
            ]
          },
          {
            "id": "note-2",
            "title": "Build ideas",
            "body": "Fire sword first, then armor.",
            "items": []
          },
          {
            "id": "note-3",
            "title": "A very long note title that must be cut in the selector and in the list",
            "body": "",
            "items": [
              {
                "id": "local-4",
                "text": "One entry",
                "checked": false
              }
            ]
          },
          {
            "id": "note-4",
            "title": "Route",
            "body": "North gate, then the river.",
            "items": [
              {
                "id": "local-5",
                "text": "Buy a map",
                "checked": true
              }
            ]
          }
        ]
      }
    }
  },
  "steps": [
    {
      "expect": {
        "text": [
          "Expedition",
          "Pack torches"
        ],
        "noText": [
          "Save"
        ],
        "image": "read-only",
        "calls": [
          {
            "service": "notes.subscribe",
            "outcome": "ok"
          }
        ]
      }
    },
    {
      "pointer": {
        "click": {
          "text": "Sharpen the blade"
        }
      }
    },
    {
      "expect": {
        "calls": [],
        "intents": []
      }
    }
  ]
}
