{
  "scenarioVersion": 1,
  "name": "accent",
  "description": "The user's accent, dark theme, changed while the widget runs: nothing reloads. The running stopwatch, its buttons in Interactive mode, where the accent shows nowhere; then the Pause button reached with Tab, inside the focus ring OverCrow draws. Lime first, then red, steel and blue; the next state in blue, red and steel.",
  "host": {
    "mode": "interactive",
    "theme": "dark",
    "scale": 1000,
    "userAccent": "lime"
  },
  "fixtures": {
    "subscriptions": {
      "stopwatch.subscribe": {
        "running": true,
        "elapsedMs": 123450,
        "at": 0,
        "shortcuts": {
          "toggle": "Super+Alt+T",
          "reset": "Super+Alt+Z",
          "bound": true
        }
      }
    }
  },
  "steps": [
    {
      "expect": {
        "state": "running",
        "text": [
          "00:02:03.45",
          "Super+Alt+T  Start / pause  ·  Super+Alt+Z  Reset"
        ]
      }
    },
    {
      "expect": {
        "state": "running",
        "fault": "none",
        "image": "running-lime"
      }
    },
    {
      "host": {
        "userAccent": "red"
      }
    },
    {
      "expect": {
        "state": "running",
        "fault": "none",
        "image": "running-red"
      }
    },
    {
      "host": {
        "userAccent": "steel"
      }
    },
    {
      "expect": {
        "state": "running",
        "fault": "none",
        "image": "running-steel"
      }
    },
    {
      "host": {
        "userAccent": "blue"
      }
    },
    {
      "expect": {
        "state": "running",
        "fault": "none",
        "image": "running-blue"
      }
    },
    {
      "pointer": {
        "move": {
          "text": "00:02:03.45"
        }
      }
    },
    {
      "key": {
        "key": "Tab"
      }
    },
    {
      "expect": {
        "state": "running",
        "fault": "none"
      }
    },
    {
      "expect": {
        "state": "running",
        "fault": "none",
        "image": "focus-blue"
      }
    },
    {
      "host": {
        "userAccent": "red"
      }
    },
    {
      "expect": {
        "state": "running",
        "fault": "none",
        "image": "focus-red"
      }
    },
    {
      "host": {
        "userAccent": "steel"
      }
    },
    {
      "expect": {
        "state": "running",
        "fault": "none",
        "image": "focus-steel"
      }
    }
  ]
}
