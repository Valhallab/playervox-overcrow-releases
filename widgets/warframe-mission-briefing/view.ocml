<!-- The briefing of the chosen Warframe mission: the faction, the damage
     types it is weak to and the one to avoid, then what changes the
     mission. One line while waiting, and in the One line layout. -->
<!-- A damage type's symbol: the game's, or our icon in the same place. -->
<component name="symbol" props="d size">
  <box class={"sym sym-" + size}>
    <if test={d.src != ""}>
      <image class="sym-img" src={d.src}/>
    </if>
    <else>
      <icon class={"sym-icon d-" + d.id} name={d.icon}/>
    </else>
  </box>
</component>

<box class={rootClass(state.brief)}>
  <if test={state.brief.mode == "wait"}>
    <box class="line">
      <icon class={"line-icon tone-" + state.brief.waitTone} name={state.brief.waitIcon}/>
      <text class="wait-text" label={state.brief.waitLabel}>{state.brief.waitText}</text>
    </box>
  </if>
  <else-if test={state.brief.mode == "strip"}>
    <box class="line">
      <box class={state.brief.dot}/>
      <text class="strip-faction" label={state.brief.faction}>{state.brief.faction}</text>
      <if test={state.brief.use.length > 0}>
        <text class="meta-sep">·</text>
        <text class="strip-name strip-joined">{names(state.brief.use)}</text>
        <for each={state.brief.use} as="d" key={d.id}>
          <box class="strip-dmg">
            <symbol d={d} size={"s"}/>
            <text class="strip-name">{d.name}</text>
          </box>
        </for>
      </if>
    </box>
  </else-if>
  <else>
    <box class="enemy">
      <if test={state.brief.eyebrow != ""}>
        <box class="eyebrow-row">
          <icon class="eyebrow-icon" name="rotate-ccw"/>
          <text class="eyebrow">{state.brief.eyebrow}</text>
        </box>
      </if>
      <if test={state.brief.where != ""}>
        <text class="where">{state.brief.where}</text>
      </if>
      <box class="faction-big">
        <box class={state.brief.dot}/>
        <text class="faction-name">{state.brief.faction}</text>
        <if test={state.brief.level != ""}>
          <text class="level-sep">·</text>
          <text class="level">{state.brief.level}</text>
        </if>
      </box>
      <if test={state.brief.use.length > 0}>
        <box class="use-row">
          <text class="use-label">{t("use")}</text>
          <box class="chips">
            <for each={state.brief.use} as="d" key={d.id}>
              <box class="chip">
                <symbol d={d} size={"m"}/>
                <text class="chip-text">{d.name}</text>
              </box>
            </for>
          </box>
        </box>
      </if>
      <if test={state.brief.avoid.length > 0}>
        <box class="avoid-row">
          <icon class="avoid-icon" name="ban"/>
          <text class="avoid-text">{t("avoid", { list: names(state.brief.avoid) })}</text>
        </box>
      </if>
    </box>
    <if test={state.brief.mods.length > 0}>
      <box class="mods">
        <for each={state.brief.mods} as="x" key={x.id}>
          <box class="mod">
            <icon class="mod-icon" name={x.icon}/>
            <box class="mod-body">
              <text class="mod-title">{x.title}</text>
              <if test={x.text != ""}>
                <text class="mod-text">{x.text}</text>
              </if>
            </box>
          </box>
        </for>
      </box>
    </if>
    <if test={state.brief.note != ""}>
      <box class="status-line">
        <icon class="status-icon" name="info"/>
        <text class="note">{state.brief.note}</text>
      </box>
    </if>
  </else>
</box>
