{
  "scenarioVersion": 1,
  "name": "accent",
  "description": "The user's accent, dark theme, changed while the widget runs: nothing reloads. The readings have no control and no accent colour; their threshold colours are status colours and never follow the accent. Lime first, then red, steel and blue.",
  "host": {
    "theme": "dark",
    "scale": 1000,
    "userAccent": "lime"
  },
  "fixtures": {
    "subscriptions": {
      "telemetry.subscribe": {
        "cpu": 23.0,
        "ram": 3221225472,
        "cpuTemperature": 61.0,
        "gpuTemperature": 67.0,
        "sources": {
          "cpuTemperature": true,
          "gpuTemperature": true
        }
      },
      "fps.subscribe": {
        "fps": 144,
        "stale": false,
        "status": "ready"
      }
    }
  },
  "steps": [
    {
      "expect": {
        "state": "running",
        "text": [
          "CPU",
          "23.0",
          "RAM",
          "3.0",
          "61.0",
          "67.0",
          "144"
        ]
      }
    },
    {
      "expect": {
        "state": "running",
        "fault": "none",
        "image": "preview-lime"
      }
    },
    {
      "host": {
        "userAccent": "red"
      }
    },
    {
      "expect": {
        "state": "running",
        "fault": "none",
        "image": "preview-red"
      }
    },
    {
      "host": {
        "userAccent": "steel"
      }
    },
    {
      "expect": {
        "state": "running",
        "fault": "none",
        "image": "preview-steel"
      }
    },
    {
      "host": {
        "userAccent": "blue"
      }
    },
    {
      "expect": {
        "state": "running",
        "fault": "none",
        "image": "preview-blue"
      }
    }
  ]
}
