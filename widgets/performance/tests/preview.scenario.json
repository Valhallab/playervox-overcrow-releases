{
  "scenarioVersion": 1,
  "name": "preview",
  "description": "Every metric shown: CPU, memory, both temperatures and the frame rate. The marketplace preview: dark theme, English, 150 %, on the stage colour; scripts/compose-previews.mjs frames it into assets/preview.png.",
  "host": {
    "scale": 1500,
    "background": "#1e242e"
  },
  "fixtures": {
    "subscriptions": {
      "telemetry.subscribe": {
        "cpu": 23.0,
        "ram": 3221225472,
        "cpuTemperature": 61.0,
        "gpuTemperature": 67.0,
        "sources": {
          "cpuTemperature": true,
          "gpuTemperature": true
        }
      },
      "fps.subscribe": {
        "fps": 144,
        "stale": false,
        "status": "ready"
      }
    }
  },
  "steps": [
    {
      "expect": {
        "state": "running",
        "text": [
          "CPU",
          "23.0",
          "RAM",
          "3.0",
          "61.0",
          "67.0",
          "144"
        ],
        "image": "preview"
      }
    }
  ]
}
