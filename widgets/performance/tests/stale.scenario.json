{
  "scenarioVersion": 1,
  "name": "stale",
  "description": "The host keeps the frame rate through a gap of its capture and marks it stale: the number stays exactly as it was, with no sign of its age; a new sample replaces it, and no value hides the row.",
  "fixtures": {
    "subscriptions": {
      "telemetry.subscribe": {
        "cpu": 23.0,
        "ram": 3221225472,
        "cpuTemperature": 61.0,
        "gpuTemperature": 67.0,
        "sources": {
          "cpuTemperature": true,
          "gpuTemperature": true
        }
      },
      "fps.subscribe": {
        "fps": 144,
        "stale": false,
        "status": "ready"
      }
    }
  },
  "steps": [
    {
      "publish": {
        "service": "fps.subscribe",
        "value": {
          "fps": 144,
          "stale": true,
          "status": "ready"
        }
      }
    },
    {
      "expect": {
        "text": [
          "144"
        ],
        "image": "kept-dark-en",
        "noText": [
          " old"
        ]
      }
    },
    {
      "host": {
        "locale": "fr",
        "theme": "light"
      }
    },
    {
      "expect": {
        "image": "kept-light-fr",
        "noText": [
          " ancien"
        ]
      }
    },
    {
      "host": {
        "scale": 1500
      }
    },
    {
      "expect": {
        "image": "kept-light-fr-150"
      }
    },
    {
      "publish": {
        "service": "fps.subscribe",
        "value": {
          "fps": 60,
          "stale": false,
          "status": "ready"
        }
      }
    },
    {
      "expect": {
        "text": [
          "60"
        ],
        "noText": [
          "144",
          " ancien"
        ]
      }
    },
    {
      "publish": {
        "service": "fps.subscribe",
        "value": {
          "fps": null,
          "stale": false,
          "status": "unavailable"
        }
      }
    },
    {
      "expect": {
        "noText": [
          "FPS",
          "60"
        ],
        "fault": "none"
      }
    }
  ]
}
