{
  "schemaVersion": 1,
  "apiVersion": 1,
  "id": "com.playervox.overcrow.performance",
  "version": "1.0.1",
  "name": {
    "en": "Performance",
    "fr": "Performances"
  },
  "sizing": {
    "fit": "both",
    "preferred": { "width": 180, "height": 150 },
    "min": { "width": 24, "height": 24 },
    "max": { "width": 800, "height": 400 }
  },
  "permissions": {
    "capabilities": ["telemetry.read", "fps.read"]
  },
  "wrapper": {
    "menu": [
      {
        "type": "choice",
        "id": "layout",
        "label": { "en": "Layout", "fr": "Disposition" },
        "choices": [
          { "value": "vertical", "label": { "en": "Vertical", "fr": "Verticale" } },
          { "value": "horizontal", "label": { "en": "Horizontal", "fr": "Horizontale" } }
        ],
        "default": "vertical"
      },
      {
        "type": "group",
        "id": "shown-values",
        "label": { "en": "Shown values", "fr": "Valeurs affichées" },
        "rows": [
          {
            "type": "toggle",
            "id": "show-cpu",
            "label": { "en": "CPU", "fr": "CPU" },
            "default": true
          },
          {
            "type": "toggle",
            "id": "show-ram",
            "label": { "en": "RAM", "fr": "RAM" },
            "default": true
          },
          {
            "type": "toggle",
            "id": "show-cpu-temperature",
            "label": { "en": "CPU temperature", "fr": "Température CPU" },
            "requires": "telemetry.cpuTemperature",
            "default": true
          },
          {
            "type": "toggle",
            "id": "show-gpu-temperature",
            "label": { "en": "GPU temperature", "fr": "Température GPU" },
            "requires": "telemetry.gpuTemperature",
            "default": true
          },
          {
            "type": "toggle",
            "id": "show-fps",
            "label": { "en": "FPS", "fr": "FPS" },
            "requires": "fps",
            "default": true
          }
        ]
      },
      {
        "type": "choice",
        "id": "temperature-unit",
        "label": { "en": "Temperature", "fr": "Température" },
        "choices": [
          { "value": "celsius", "label": { "en": "Celsius (°C)", "fr": "Celsius (°C)" } },
          { "value": "fahrenheit", "label": { "en": "Fahrenheit (°F)", "fr": "Fahrenheit (°F)" } }
        ],
        "default": "celsius"
      }
    ]
  }
}
