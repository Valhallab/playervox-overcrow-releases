{
  "schemaVersion": 1,
  "apiVersion": 1,
  "id": "com.playervox.overcrow.playervox.reviews",
  "version": "1.0.2",
  "name": {
    "en": "Player reviews",
    "fr": "Avis des joueurs"
  },
  "sizing": {
    "fit": "height",
    "preferred": { "width": 350, "height": 320 },
    "min": { "width": 280, "height": 60 },
    "max": { "width": 900, "height": 480 }
  },
  "permissions": {
    "capabilities": ["playervox.reviews.read"]
  },
  "wrapper": {
    "menu": [
      {
        "type": "toggle",
        "id": "followed-only",
        "label": { "en": "Followed players only", "fr": "Joueurs suivis uniquement" },
        "icon": "users",
        "default": false
      }
    ]
  }
}
