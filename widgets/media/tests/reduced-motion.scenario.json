{
  "scenarioVersion": 1,
  "name": "reduced-motion",
  "description": "With the user's reduced-motion preference a title wider than its column does not scroll: it ends with an ellipsis and stays there, as with the scrolling option off. Turned off while the widget runs, the title scrolls again; turned on again, it is cut at once.",
  "host": {
    "reducedMotion": true
  },
  "assets": {
    "aurora": "tests/assets/aurora.png",
    "horizon": "tests/assets/horizon.png",
    "tiles": "tests/assets/tiles.png"
  },
  "fixtures": {
    "subscriptions": {
      "media.subscribe": {
        "player": "p1",
        "title": "Beyond the northern lights, and the long road back",
        "artists": [
          "The Quiet Expedition",
          "An Orchestra of Many Distant Places",
          "Guest"
        ],
        "playing": true,
        "canPrevious": true,
        "canPlayPause": true,
        "canNext": true,
        "cover": "fixture:aurora"
      }
    }
  },
  "steps": [
    {
      "expect": {
        "state": "running",
        "text": [
          "Beyond the northern lights, and the long road back"
        ],
        "image": "cut"
      }
    },
    {
      "advance": {
        "ms": 4000
      }
    },
    {
      "expect": {
        "image": "still-cut"
      }
    },
    {
      "host": {
        "reducedMotion": false
      }
    },
    {
      "advance": {
        "ms": 4000
      }
    },
    {
      "expect": {
        "image": "scrolling-again"
      }
    },
    {
      "host": {
        "reducedMotion": true
      }
    },
    {
      "expect": {
        "image": "cut-again",
        "fault": "none"
      }
    }
  ]
}
