{
  "scenarioVersion": 1,
  "name": "refused",
  "description": "Without the permission to read the chat the widget asks OverCrow nothing and says what it lacks, in both modes and languages.",
  "host": {
    "grants": []
  },
  "steps": [
    {
      "expect": {
        "text": [
          "Twitch",
          "Allow access to Twitch chat in the Control Center."
        ],
        "noText": [
          "Join chat",
          "Send"
        ],
        "state": "running",
        "calls": [],
        "image": "refused"
      }
    },
    {
      "host": {
        "mode": "interactive"
      }
    },
    {
      "expect": {
        "text": [
          "Allow access to Twitch chat in the Control Center."
        ],
        "noText": [
          "Join chat",
          "Send"
        ],
        "calls": [],
        "image": "refused-interactive"
      }
    },
    {
      "host": {
        "locale": "fr",
        "theme": "light"
      }
    },
    {
      "advance": {
        "ms": 60000
      }
    },
    {
      "expect": {
        "text": [
          "Autorisez l’accès au chat Twitch dans le Centre de contrôle."
        ],
        "calls": [],
        "intents": [],
        "fault": "none",
        "image": "refused-light-fr"
      }
    }
  ]
}
