            "outcome": "ok"
          }
        ]
      }
    },
    {
      "publish": {
        "service": "twitch.chat.subscribe",
        "value": {
          "account": "connected",
          "channel": "juniper_plays",
          "joinState": "failed",
          "failure": "channel_unavailable",
