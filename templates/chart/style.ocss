.panel {
  flex-direction: column;
  gap: var(--space-2);
  padding: var(--space-3);
}

.header {
  justify-content: space-between;
  align-items: center;
}

.title {
  font-size: var(--font-size-title);
}

.value {
  font-size: var(--font-size-value);
  font-variant-numeric: tabular-nums;
}

.plot {
  flex-grow: 1;
}

.series {
  color: var(--color-accent);
}
